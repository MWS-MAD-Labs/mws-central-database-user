  version         Int      @default(1)
  is_active       Boolean  @default(true)
  granted_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([person_id, application_id])
  @@index([application_id, organization_id, is_active])
  @@map("application_entitlements")
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  entity_type   String?
  entity_id     String?
  admin_id      String?
  admin         AdminUser?  @relation(fields: [admin_id], references: [id])
  api_client_id String?
  api_client    ApiClient?  @relation(fields: [api_client_id], references: [id])
  old_values    Json?
  new_values    Json?
  ip_address    String?
  user_agent    String?
  source        AuditSource @default(UI)
  created_at    DateTime    @default(now())

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model ImportJob {
  id             String       @id @default(cuid())
  type           ImportType
  mode           ImportMode   @default(FULL_REGISTRATION)
  status         ImportStatus @default(PENDING)
  file_name      String?
  total_rows     Int?
  valid_rows     Int?
  error_rows     Int?
  result_summary Json?
  error_details  Json?
  field_mapping  Json?
  staged_rows    Json?
  created_by     String
  created_at     DateTime     @default(now())
  completed_at   DateTime?

  @@map("import_jobs")
}

model SyncLog {
  id            String   @id @default(cuid())
  source        String
  total_rows    Int?
  synced_rows   Int?
  conflict_rows Int?
  error_rows    Int?
  details       Json?
  created_by    String
  created_at    DateTime @default(now())

  @@map("sync_logs")
}

enum IdentifierChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Approval workflow for editing a sensitive identifier field after its
// 24h grace period has locked it (see identifier-lock.ts). entity_type is
// "Employee" or "Student"; field_name is one of the identifier fields each
// service's assertIdentifierFieldsEditable already governs.
model IdentifierChangeRequest {
  id            String                        @id @default(cuid())
  entity_type   String
  entity_id     String
  field_name    String
  old_value     String?
  new_value     String
  reason        String
  status        IdentifierChangeRequestStatus @default(PENDING)
  requested_by  String
  requester     AdminUser                     @relation("IdentifierChangeRequester", fields: [requested_by], references: [id])
  requested_at  DateTime                      @default(now())
  decided_by    String?
  decider       AdminUser?                    @relation("IdentifierChangeDecider", fields: [decided_by], references: [id])
  decided_at    DateTime?
  decision_note String?

  @@index([entity_type, entity_id, status])
  @@map("identifier_change_requests")
}
