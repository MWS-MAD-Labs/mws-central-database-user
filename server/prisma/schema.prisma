generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PersonType {
  STUDENT
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  PROTESTANTISM
  CATHOLICISM
  HINDUISM
  BUDDHISM
  CONFUCIANISM
  OTHER
}

enum StudentStatus {
  REGISTERED
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

// Drives digit 4 of the auto-generated NIS (0=PRE_K, 1=PSB, 2=TRANSFER).
enum StudentEntryType {
  PRE_K
  PSB
  TRANSFER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  ON_LEAVE
  ARCHIVED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  PROBATION
  FREELANCE
  WFH
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum InternStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

enum EducationLevel {
  SD
  SMP
  SMA_SMK
  D1
  D2
  D3
  D4
  S1
  S2
  S3
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
}

enum ConsentType {
  MEDIA_CONSENT
  PARENT_CONSENT
  DOCUMENTATION_CONSENT
  OTHER
}

enum VaccineType {
  POLIO
  DPT
  MEASLES
  HEPATITIS_B
  BCG
  MMR
  COVID_1
  COVID_2
}

enum ConsentStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum PCDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
}

enum HealthNoteCategory {
  HEALTH_INFO
  SPECIAL_NEEDS
}

enum HealthNoteStatus {
  ACTIVE
  RESOLVED
}

enum BloodType {
  A
  B
  AB
  O
  UNKNOWN
}

enum AdminRole {
  SUPER_ADMIN
  DATABASE_ADMIN
  VIEWER
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  UNAUTHORIZED_ACCESS
  CREATE_STUDENT
  UPDATE_STUDENT
  DEACTIVATE_STUDENT
  REACTIVATE_STUDENT
  DELETE_STUDENT
  REISSUE_STUDENT_NIS
  UPLOAD_STUDENT_PHOTO
  DELETE_STUDENT_PHOTO
  ROLLBACK_STUDENT_MUTATION
  CREATE_EMPLOYEE
  UPDATE_EMPLOYEE
  DEACTIVATE_EMPLOYEE
  DELETE_EMPLOYEE
  CREATE_INTERN
  UPDATE_INTERN
  DELETE_INTERN
  UPLOAD_EMPLOYEE_PHOTO
  DELETE_EMPLOYEE_PHOTO
  ROLLBACK_EMPLOYEE_MUTATION
  ROLLBACK_PC_ACTIVITY_MENTOR_MUTATION
  EXTEND_EMPLOYEE_CONTRACT
  AUTO_RESIGN_EMPLOYEE
  ISSUE_DISCIPLINARY_ACTION
  UPDATE_DISCIPLINARY_ACTION
  RESOLVE_DISCIPLINARY_ACTION
  REVOKE_DISCIPLINARY_ACTION
  AUTO_EXPIRE_DISCIPLINARY_ACTION
  CREATE_ACADEMIC_YEAR
  UPDATE_ACADEMIC_YEAR
  DELETE_ACADEMIC_YEAR
  CREATE_CLASS
  UPDATE_CLASS
  DELETE_CLASS
  ASSIGN_CLASS_TEACHER
  END_CLASS_TEACHER_ASSIGNMENT
  DELETE_CLASS_TEACHER_ASSIGNMENT
  REOPEN_CLASS_TEACHER_ASSIGNMENT
  CREATE_ENROLLMENT
  PROMOTE_STUDENT
  TRANSFER_STUDENT_CLASS
  FIX_ENROLLMENT_CLASS
  WITHDRAW_STUDENT_ENROLLMENT
  DELETE_ENROLLMENT
  RESTORE_ENROLLMENT
  REACTIVATE_ENROLLMENT
  ROLLBACK_PROMOTE_ENROLLMENT
  CREATE_PARENT_GUARDIAN
  UPDATE_PARENT_GUARDIAN
  DELETE_PARENT_GUARDIAN
  CREATE_CONSENT
  UPDATE_CONSENT
  DELETE_CONSENT
  CREATE_HEALTH_RECORD
  UPDATE_HEALTH_RECORD
  DELETE_HEALTH_RECORD
  CREATE_HEALTH_NOTE
  UPDATE_HEALTH_NOTE
  DELETE_HEALTH_NOTE
  CREATE_VACCINE_RECORD
  UPDATE_VACCINE_RECORD
  DELETE_VACCINE_RECORD
  ASSIGN_STUDENT_SUPPORT
  END_STUDENT_SUPPORT_ASSIGNMENT
  DELETE_STUDENT_SUPPORT_ASSIGNMENT
  REACTIVATE_STUDENT_SUPPORT_ASSIGNMENT
  CREATE_PC_ACTIVITY
  UPDATE_PC_ACTIVITY
  DELETE_PC_ACTIVITY
  CREATE_MASTER_DATA
  UPDATE_MASTER_DATA
  DELETE_MASTER_DATA
  IMPORT_DATA
  ROLLBACK_IMPORT
  EXPORT_DATA
  UPLOAD_ATTACHMENT
  DOWNLOAD_ATTACHMENT
  DELETE_ATTACHMENT
  RESTORE_ATTACHMENT
  ACCESS_HEALTH_DATA
  ACCESS_EMPLOYEE_PII
  API_ACCESS
  API_TOKEN_CREATE
  API_TOKEN_REVOKE
  API_TOKEN_ROTATE
  API_TOKEN_UPDATE_SCOPES
  ROLE_CHANGE
  PERMISSION_CHANGE
}

enum AuditSource {
  UI
  API
  SYSTEM
  IMPORT
}

enum ImportType {
  STUDENT
  EMPLOYEE
}

enum ImportMode {
  FULL_REGISTRATION
  RELATION_ATTACH
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  ROLLED_BACK
}

model MasterUnit {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  admin_users AdminUser[]

  grades Grade[]

  mutation_history EmployeeMutationHistory[]

  pc_activity_default_mentors PCActivityDefaultMentor[]
  pc_activity_mentor_mutation_history PCActivityMentorMutationHistory[]

  job_position_units MasterJobPositionUnit[]
  job_level_units    MasterJobLevelUnit[]
  pc_activity_units  MasterPCActivityUnit[]

  @@map("master_units")
}

model MasterJobPosition {
  id                   String      @id @default(cuid())
  name                 String      @unique
  is_teaching_position Boolean     @default(false)
  is_homeroom_position Boolean     @default(false)
  is_subject_teacher_position Boolean @default(false)
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  // Empty allows this position in any unit; rows restrict it to listed units.
  units MasterJobPositionUnit[]

  employees Employee[]
  interns   Intern[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_job_positions")
}

model MasterJobPositionUnit {
  job_position_id String
  unit_id         String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id], onDelete: Cascade)
  unit            MasterUnit        @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([job_position_id, unit_id])
  @@map("master_job_position_units")
}

model MasterJobLevel {
  id               String   @id @default(cuid())
  name             String   @unique
  is_teaching_role Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Empty allows this level in any unit; rows restrict it to listed units.
  units MasterJobLevelUnit[]

  employees Employee[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_job_levels")
}

model MasterJobLevelUnit {
  job_level_id String
  unit_id      String
  job_level    MasterJobLevel @relation(fields: [job_level_id], references: [id], onDelete: Cascade)
  unit         MasterUnit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([job_level_id, unit_id])
  @@map("master_job_level_units")
}

model MasterBuilding {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_buildings")
}

model MasterPCActivity {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pc_activities   PassionConnectionActivity[]
  default_mentors PCActivityDefaultMentor[]
  mentor_mutation_history PCActivityMentorMutationHistory[]
  // Empty allows this activity in any unit; rows restrict it to listed units.
  units MasterPCActivityUnit[]

  @@map("master_pc_activities")
}

model MasterPCActivityUnit {
  activity_id String
  unit_id     String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  unit        MasterUnit       @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([activity_id, unit_id])
  @@map("master_pc_activity_units")
}

// Stores the default mentor for an activity in one unit.
// Missing rows mean that unit has no default mentor.
model PCActivityDefaultMentor {
  id          String           @id @default(cuid())
  activity_id String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id])
  unit_id     String
  unit        MasterUnit       @relation(fields: [unit_id], references: [id])
  mentor_id   String
  mentor      Employee         @relation(fields: [mentor_id], references: [id])
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@unique([activity_id, unit_id])
  @@map("pc_activity_default_mentors")
}

// Append-only mentor history with one open row per activity and unit.
// Clearing a mentor opens a row with a null mentor_id.
model PCActivityMentorMutationHistory {
  id          String           @id @default(cuid())
  activity_id String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id])
  unit_id     String
  unit        MasterUnit       @relation(fields: [unit_id], references: [id])
  // Null records an explicit period with no default mentor.
  mentor_id String?
  mentor    Employee? @relation(fields: [mentor_id], references: [id])

  start_date DateTime
  end_date   DateTime?

  // @unique keeps Prisma's one-to-one shape; the database uses a partial unique index.
  // Preserve the partial index so rolled-back values can be reused.
  previous_history_id String?                           @unique
  previous_history     PCActivityMentorMutationHistory? @relation("PCActivityMentorMutationChain", fields: [previous_history_id], references: [id])
  next_history         PCActivityMentorMutationHistory? @relation("PCActivityMentorMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("pc_activity_mentor_mutation_histories")
}

// Suggestion values only; employee education fields remain free text.
model MasterInstitution {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_institutions")
}

model MasterMajor {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_majors")
}

model Person {
  id               String     @id @default(cuid())
  full_name        String
  nick_name        String
  email            String     @unique
  person_type      PersonType
  gender           Gender
  religion         Religion
  // Set for an explicit OTHER religion; null may indicate a legacy placeholder.
  religion_other   String?
  birth_place      String
  birth_date       DateTime
  // Legacy external photo URL used when photo_object_key is unset.
  photo_url        String?
  // Private object key. Presigned URLs are generated on read and never stored.
  photo_object_key String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  student   Student?
  employee  Employee?
  adminUser AdminUser?

  @@map("persons")
}

model Student {
  id                    String           @id @default(cuid())
  person_id             String           @unique
  person                Person           @relation(fields: [person_id], references: [id])
  // Invalid legacy values stay in legacy_nis until a valid NIS is issued.
  nis                   String?          @unique
  legacy_nis            String?
  // Invalid legacy values stay in legacy_nisn instead of blocking import.
  nisn                  String?          @unique
  legacy_nisn           String?
  status                StudentStatus    @default(REGISTERED)
  pre_delete_status     StudentStatus?
  current_grade_id      String
  current_grade         Grade            @relation("StudentCurrentGrade", fields: [current_grade_id], references: [id])
  current_class_id      String?
  current_class         Class?           @relation("CurrentClass", fields: [current_class_id], references: [id])
  join_academic_year_id String
  join_academic_year    AcademicYear     @relation("StudentJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  join_grade_id         String
  join_grade            Grade            @relation("StudentJoinGrade", fields: [join_grade_id], references: [id])
  graduation_grade      String?
  previous_school       String?
  leave_year            String?
  // Legacy SN values are booleans from the source sheet.
  sn                    Boolean          @default(false)
  pickup_drop_service   Boolean          @default(false)
  catering_service      Boolean          @default(false)
  psb_guide             Boolean          @default(false)
  // The database default only backfills existing rows; creates require this field.
  entry_type            StudentEntryType @default(PSB)
  // Tracks fields filled with placeholders during legacy import.
  // Updating a tracked field removes its key.
  import_defaulted_fields String[]       @default([])
  // Records an approved join-grade mismatch and clears when either grade changes.
  grade_consistency_override_reason String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  deleted_at            DateTime?

  parents             ParentGuardian[]
  enrollments         StudentClassEnrollment[]
  consents            ConsentRecord[]
  health              HealthRecord?
  health_notes        HealthNote[]
  pc                  PassionConnectionActivity[]
  vaccine_records     VaccineRecord[]
  support_assignments StudentSupportAssignment[]
  mutation_history    StudentMutationHistory[]

  @@map("students")
}

model Employee {
  id              String         @id @default(cuid())
  person_id       String         @unique
  person          Person         @relation(fields: [person_id], references: [id])
  employee_id     String         @unique
  status          EmployeeStatus @default(ACTIVE)
  employment_type EmploymentType

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  job_level_id    String
  job_level       MasterJobLevel    @relation(fields: [job_level_id], references: [id])

  building_id       String
  building          MasterBuilding @relation(fields: [building_id], references: [id])
  join_date         DateTime
  // Planned expiry for contract employees, separate from last_working_date.
  contract_end_date DateTime?
  // Planned or actual last day. It does not change status automatically.
  last_working_date DateTime?
  notes             String?

  mobile_phone           String?
  residential_address    String?
  marital_status         MaritalStatus
  // Stores only the highest or most recent education record.
  education_level        EducationLevel?
  institution_name       String?
  major                  String?
  graduation_year        Int?
  // Sensitive identifiers are cleared on soft delete and retained in the audit log.
  nik                    String?         @unique
  npwp                   String?         @unique
  bank_account_number    String?         @unique
  // BPJS Kesehatan (health insurance program) - 13 digits.
  bpjs_number            String?         @unique
  // BPJS Ketenagakerjaan identifier, separate from bpjs_number, 11 digits.
  bpjs_employment_number String?         @unique
  // Legacy KPJ identifier. It may be alphanumeric and is distinct from BPJS employment.
  kpj_number              String?         @unique

  // These timestamps anchor the identifier edit window.
  // Null values fall back to created_at for compatibility.
  nik_set_at                    DateTime?
  npwp_set_at                   DateTime?
  bank_account_number_set_at    DateTime?
  bpjs_number_set_at            DateTime?
  bpjs_employment_number_set_at DateTime?
  kpj_number_set_at             DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  class_assignments    ClassTeacherAssignment[]
  student_assignments  StudentSupportAssignment[]
  pc_activity_default_mentor_for PCActivityDefaultMentor[]
  pc_activity_mentor_mutation_history PCActivityMentorMutationHistory[]
  mutation_history     EmployeeMutationHistory[]
  disciplinary_actions EmployeeDisciplinaryAction[]

  @@map("employees")
}

// Interns stay separate from Person because their required identity data differs.
model Intern {
  id        String @id @default(cuid())
  full_name String
  nick_name String
  email     String @unique

  gender         Gender
  religion       Religion
  religion_other String?
  birth_place    String?
  birth_date     DateTime?

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  building_id     String
  building        MasterBuilding    @relation(fields: [building_id], references: [id])

  status    InternStatus @default(ACTIVE)
  join_date DateTime
  end_date DateTime
  notes    String?

  mobile_phone        String?
  residential_address String?

  education_level  EducationLevel?
  institution_name String?
  major            String?
  graduation_year  Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  class_assignments ClassTeacherAssignment[]



  @@map("interns")
}

enum EmployeeMutationField {
  UNIT
  JOB_POSITION
  JOB_LEVEL
  BUILDING
  STATUS
  EMPLOYMENT_TYPE
}

// Tracks separate value periods for each employee field.
// The open row has no end_date; rollback reopens its predecessor.
model EmployeeMutationHistory {
  id          String                @id @default(cuid())
  employee_id String
  employee    Employee              @relation(fields: [employee_id], references: [id])
  field       EmployeeMutationField

  // Exactly one of these six is set, matching `field`.
  unit_id         String?
  unit            MasterUnit?        @relation(fields: [unit_id], references: [id])
  job_position_id String?
  job_position    MasterJobPosition? @relation(fields: [job_position_id], references: [id])
  job_level_id    String?
  job_level       MasterJobLevel?    @relation(fields: [job_level_id], references: [id])
  building_id     String?
  building        MasterBuilding?    @relation(fields: [building_id], references: [id])
  status          EmployeeStatus?
  employment_type EmploymentType?

  start_date DateTime
  end_date   DateTime?

  // @unique keeps Prisma's one-to-one shape; the database uses a partial unique index.
  // Preserve the partial index so rolled-back values can be reused.
  previous_history_id String?                  @unique
  previous_history    EmployeeMutationHistory? @relation("EmployeeMutationChain", fields: [previous_history_id], references: [id])
  next_history        EmployeeMutationHistory? @relation("EmployeeMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("employee_mutation_histories")
}

enum StudentMutationField {
  JOIN_GRADE
  JOIN_ACADEMIC_YEAR
  ENTRY_TYPE
}

// Tracks value periods for student fields not covered by enrollment history.
model StudentMutationHistory {
  id         String               @id @default(cuid())
  student_id String
  student    Student              @relation(fields: [student_id], references: [id])
  field      StudentMutationField

  // Exactly one of these three is set, matching `field`.
  join_grade_id         String?
  join_grade            Grade?            @relation("StudentMutationJoinGrade", fields: [join_grade_id], references: [id])
  join_academic_year_id String?
  join_academic_year    AcademicYear?     @relation("StudentMutationJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  entry_type            StudentEntryType?

  // Snapshot used to restore the grade override reason during rollback.
  grade_consistency_override_reason String?

  start_date DateTime
  end_date   DateTime?

  // @unique keeps Prisma's one-to-one shape; the database uses a partial unique index.
  // Preserve the partial index so rolled-back values can be reused.
  previous_history_id String?                 @unique
  previous_history    StudentMutationHistory? @relation("StudentMutationChain", fields: [previous_history_id], references: [id])
  next_history        StudentMutationHistory? @relation("StudentMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("student_mutation_histories")
}

enum DisciplinaryActionType {
  SURAT_TEGURAN
  SURAT_PERINGATAN
}

enum DisciplinaryActionStatus {
  ACTIVE
  EXPIRED
  RESOLVED
  REVOKED
  SUPERSEDED
}

// Issued actions are immutable except for status.
// Only one active action is allowed per employee and type.
model EmployeeDisciplinaryAction {
  id          String   @id @default(cuid())
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  type   DisciplinaryActionType
  level  Int
  status DisciplinaryActionStatus @default(ACTIVE)

  issued_date DateTime
  valid_until DateTime

  reason String
  notes  String?

  issued_by_admin_id String?
  issued_by_admin    AdminUser? @relation(fields: [issued_by_admin_id], references: [id])

  resolved_at     DateTime?
  resolved_reason String?

  attachments DisciplinaryActionAttachment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([employee_id, type, status])
  @@map("employee_disciplinary_actions")
}

model DisciplinaryActionAttachment {
  id                     String                     @id @default(cuid())
  disciplinary_action_id String
  disciplinary_action    EmployeeDisciplinaryAction @relation(fields: [disciplinary_action_id], references: [id])
  file_name              String
  object_key             String                     @unique
  file_size              Int
  mime_type              String
  uploaded_by            String
  uploaded_at            DateTime                   @default(now())
  deleted_at             DateTime?

  @@map("disciplinary_action_attachments")
}

model AdminUser {
  id        String    @id @default(cuid())
  admin_no  Int       @unique @default(autoincrement())
  email     String    @unique
  full_name String
  role      AdminRole @default(VIEWER)

  // Stable employee link that does not depend on email.
  // Nullable for older rows that could not be matched during backfill.
  person_id String? @unique
  person    Person? @relation(fields: [person_id], references: [id])

  unit_id String
  unit    MasterUnit @relation(fields: [unit_id], references: [id])

  can_view_sensitive_data Boolean   @default(false)
  can_view_all_units      Boolean   @default(false)
  can_view_employee_pii   Boolean   @default(false)
  // Class writes use student permission; teacher assignments use employee permission.
  can_write_employee_data Boolean   @default(false)
  can_write_student_data  Boolean   @default(false)
  after_hours_write_until DateTime?

  google_id          String?   @unique
  avatar_url         String?
  is_active          Boolean   @default(true)
  last_login         DateTime?
  refresh_token_hash String?   @unique
  refresh_token_exp  DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  audit_logs                  AuditLog[]
  disciplinary_actions_issued EmployeeDisciplinaryAction[]

  @@map("admin_users")
}

model WorkingDayOverride {
  id         String   @id @default(cuid())
  date       DateTime @unique
  reason     String?
  created_at DateTime @default(now())

  @@map("working_day_overrides")
}

model ParentGuardian {
  id         String     @id @default(cuid())
  student_id String
  student    Student    @relation(fields: [student_id], references: [id])
  type       ParentType
  full_name  String
  phone      String?
  // Preserves historical phone values that do not fit the current format.
  legacy_phone String?
  email      String?
  address    String?
  is_primary Boolean    @default(false)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?

  @@map("parent_guardians")
}

model ConsentRecord {
  id              String        @id @default(cuid())
  student_id      String
  student         Student       @relation(fields: [student_id], references: [id])
  consent_type    ConsentType
  status          ConsentStatus @default(PENDING)
  consent_date    DateTime?
  signed_by       String?
  notes           String?
  validity_period DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  deleted_at      DateTime?

  attachments ConsentAttachment[]

  // Uniqueness on (student_id, consent_type) enforced by a partial index in the migration.
  @@map("consent_records")
}

model ConsentAttachment {
  id          String        @id @default(cuid())
  consent_id  String
  consent     ConsentRecord @relation(fields: [consent_id], references: [id])
  file_name   String
  object_key  String        @unique
  file_size   Int
  mime_type   String
  uploaded_by String
  uploaded_at DateTime      @default(now())
  deleted_at  DateTime?

  @@map("consent_attachments")
}

model HealthRecord {
  id               String    @id @default(cuid())
  student_id       String    @unique
  student          Student   @relation(fields: [student_id], references: [id])
  blood_type       BloodType?
  needs_assistance Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  // Soft-deleted records are restored rather than recreated.
  @@map("health_records")
}

model HealthNote {
  id            String             @id @default(cuid())
  student_id    String
  student       Student            @relation(fields: [student_id], references: [id])
  category      HealthNoteCategory
  description   String
  status        HealthNoteStatus   @default(ACTIVE)
  noted_date    DateTime           @default(now())
  resolved_date DateTime?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  deleted_at    DateTime?

  @@map("health_notes")
}

model VaccineRecord {
  id           String      @id @default(cuid())
  student_id   String
  student      Student     @relation(fields: [student_id], references: [id])
  vaccine_type VaccineType
  received     Boolean     @default(false)
  date         DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?

  // Uniqueness on (student_id, vaccine_type) enforced by a partial index in the migration.
  @@map("vaccine_records")
}

// Mentor is resolved from the student's current unit at read time.
// Changing a unit default affects existing assignments.
model PassionConnectionActivity {
  id               String           @id @default(cuid())
  student_id       String
  student          Student          @relation(fields: [student_id], references: [id])
  day              PCDay
  activity_id      String
  activity         MasterPCActivity @relation(fields: [activity_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear     @relation(fields: [academic_year_id], references: [id])
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?

  // Uniqueness on (student_id, day, academic_year_id) enforced by a partial index in the migration.
  @@map("passion_connection_activities")
}

model AcademicYear {
  id         String             @id @default(cuid())
  name       String             @unique
  start_date DateTime
  end_date   DateTime?
  status     AcademicYearStatus @default(UPCOMING)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  classes                  Class[]
  enrollments              StudentClassEnrollment[]
  students_joined          Student[]                   @relation("StudentJoinAcademicYear")
  pc_activities            PassionConnectionActivity[]
  student_mutation_history StudentMutationHistory[]    @relation("StudentMutationJoinAcademicYear")

  @@map("academic_years")
}

model Grade {
  id         String      @id @default(cuid())
  name       String      @unique
  level      Int         @unique
  unit_id    String?
  unit       MasterUnit? @relation(fields: [unit_id], references: [id])
  // Reference age for registration checks; null disables the check.
  typical_age Int?
  created_at DateTime    @default(now())

  classes                  Class[]
  additional_grade_classes ClassAdditionalGrade[]
  enrollments              StudentClassEnrollment[]
  students_current         Student[]                @relation("StudentCurrentGrade")
  students_joined          Student[]                @relation("StudentJoinGrade")
  student_mutation_history StudentMutationHistory[] @relation("StudentMutationJoinGrade")

  @@map("grades")
}

model Class {
  id               String       @id @default(cuid())
  name             String
  // Primary grade for single-grade classes and one accepted grade for mixed classes.
  grade_id         String
  grade            Grade        @relation(fields: [grade_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id])
  status           ClassStatus  @default(ACTIVE)
  capacity         Int?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  current_students    Student[]                @relation("CurrentClass")
  enrollments         StudentClassEnrollment[]
  teacher_assignments ClassTeacherAssignment[]
  additional_grades   ClassAdditionalGrade[]

  @@unique([name, academic_year_id])
  @@map("classes")
}

// Adds accepted grades without changing the class's primary grade.
model ClassAdditionalGrade {
  id       String @id @default(cuid())
  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  grade_id String
  grade    Grade  @relation(fields: [grade_id], references: [id])

  @@unique([class_id, grade_id])
  @@map("class_additional_grades")
}

enum ClassTeacherRole {
  HOMEROOM
  SUPPORTING_HOMEROOM
  SUBJECT_TEACHER
}

model ClassTeacherAssignment {
  id          String           @id @default(cuid())
  class_id    String
  class       Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  employee_id String?
  employee    Employee?        @relation(fields: [employee_id], references: [id])
  intern_id   String?
  intern      Intern?          @relation(fields: [intern_id], references: [id])
  role        ClassTeacherRole @default(HOMEROOM)
  // Homeroom roles are capped per employee and academic year in application code.
  // Subject-teacher assignments have no per-employee cap.
  subject     String?
  start_date  DateTime         @default(now())
  end_date    DateTime?
  created_at  DateTime         @default(now())
  // Marks mistaken assignments; end_date closes valid assignments.
  deleted_at  DateTime?

  @@map("class_teacher_assignments")
}

enum StudentSupportRole {
  SPECIAL_ED
}

// Assigns support to a student rather than a class.
model StudentSupportAssignment {
  id          String             @id @default(cuid())
  student_id  String
  student     Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  employee_id String
  employee    Employee           @relation(fields: [employee_id], references: [id])
  role        StudentSupportRole @default(SPECIAL_ED)
  notes       String?
  start_date  DateTime           @default(now())
  end_date    DateTime?
  created_at  DateTime           @default(now())
  deleted_at  DateTime?

  @@map("student_support_assignments")
}

model StudentClassEnrollment {
  id                          String                   @id @default(cuid())
  student_id                  String
  student                     Student                  @relation(fields: [student_id], references: [id])
  academic_year_id            String
  academic_year               AcademicYear             @relation(fields: [academic_year_id], references: [id])
  class_id                    String
  class                       Class                    @relation(fields: [class_id], references: [id])
  grade_level                 String
  // Enrollment grade may differ from the primary grade in mixed-grade classes.
  grade_id                    String
  grade                       Grade                    @relation(fields: [grade_id], references: [id])
  class_name_snapshot         String
  enrollment_status           EnrollmentStatus         @default(ACTIVE)
  start_date                  DateTime?
  end_date                    DateTime?
  // Marks enrollment in the same or a lower grade than the previous enrollment.
  is_retention                Boolean                  @default(false)
  retention_reason            String?
  // Legacy active enrollments must be promoted rather than followed by another create.
  is_legacy                   Boolean                  @default(false)
  // Links a promoted enrollment to the row restored during rollback.
  promoted_from_enrollment_id String?
  promoted_from               StudentClassEnrollment?  @relation("EnrollmentPromotion", fields: [promoted_from_enrollment_id], references: [id])
  promoted_to                 StudentClassEnrollment[] @relation("EnrollmentPromotion")
  created_at                  DateTime                 @default(now())
  updated_at                  DateTime                 @updatedAt
  deleted_at                  DateTime?

  // Uniqueness on (student_id, academic_year_id) enforced by a partial index in the migration.
  @@index([promoted_from_enrollment_id])
  @@map("student_class_enrollments")
}

model ApiClient {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  token_prefix String    @unique
  token_hash   String
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  last_used_at DateTime?

  scopes     ApiClientScope[]
  audit_logs AuditLog[]

  @@map("api_clients")
}

model ApiScope {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  clients ApiClientScope[]

  @@map("api_scopes")
}

model ApiClientScope {
  client_id String
  scope_id  String
  client    ApiClient @relation(fields: [client_id], references: [id], onDelete: Cascade)
  scope     ApiScope  @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@id([client_id, scope_id])
  @@map("api_client_scopes")
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  entity_type   String?
  entity_id     String?
  admin_id      String?
  admin         AdminUser?  @relation(fields: [admin_id], references: [id])
  api_client_id String?
  api_client    ApiClient?  @relation(fields: [api_client_id], references: [id])
  old_values    Json?
  new_values    Json?
  ip_address    String?
  user_agent    String?
  source        AuditSource @default(UI)
  created_at    DateTime    @default(now())

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model ImportJob {
  id             String       @id @default(cuid())
  type           ImportType
  mode           ImportMode   @default(FULL_REGISTRATION)
  status         ImportStatus @default(PENDING)
  file_name      String?
  total_rows     Int?
  valid_rows     Int?
  error_rows     Int?
  result_summary Json?
  error_details  Json?
  field_mapping  Json?
  staged_rows    Json?
  created_by     String
  created_at     DateTime     @default(now())
  completed_at   DateTime?

  @@map("import_jobs")
}

model SyncLog {
  id            String   @id @default(cuid())
  source        String
  total_rows    Int?
  synced_rows   Int?
  conflict_rows Int?
  error_rows    Int?
  details       Json?
  created_by    String
  created_at    DateTime @default(now())

  @@map("sync_logs")
}
