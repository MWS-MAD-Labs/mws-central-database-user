  // Reference age for registration checks; null disables the check.
  typical_age Int?
  created_at  DateTime   @default(now())

  classes                          Class[]
  additional_grade_classes         ClassAdditionalGrade[]
  enrollments                      StudentClassEnrollment[]
  students_current                 Student[]                @relation("StudentCurrentGrade")
  students_joined                  Student[]                @relation("StudentJoinGrade")
  student_mutation_history         StudentMutationHistory[] @relation("StudentMutationJoinGrade")
  student_mutation_history_current StudentMutationHistory[] @relation("StudentMutationCurrentGrade")
  pc_activity_room_grades          PcActivityRoomGrade[]

  @@map("grades")
}

model Class {
  id               String       @id @default(cuid())
  name             String
  // Primary grade for single-grade classes and one accepted grade for mixed classes.
  grade_id         String
  grade            Grade        @relation(fields: [grade_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id])
  status           ClassStatus  @default(ACTIVE)
  capacity         Int?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  current_students         Student[]                @relation("CurrentClass")
  enrollments              StudentClassEnrollment[]
  teacher_assignments      ClassTeacherAssignment[]
  additional_grades        ClassAdditionalGrade[]
  pc_activity_room_scopes  PcActivityRoomClass[]
  student_mutation_history StudentMutationHistory[] @relation("StudentMutationClass")

  @@unique([name, academic_year_id])
  @@map("classes")
}

// Adds accepted grades without changing the class's primary grade.
model ClassAdditionalGrade {
  id       String @id @default(cuid())
  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  grade_id String
  grade    Grade  @relation(fields: [grade_id], references: [id])

  @@unique([class_id, grade_id])
  @@map("class_additional_grades")
}

enum ClassTeacherRole {
  HOMEROOM
  SUPPORTING_HOMEROOM
  SUBJECT_TEACHER
}

model ClassTeacherAssignment {
