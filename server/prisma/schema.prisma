  STUDENT
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  PROTESTANTISM
  CATHOLICISM
  HINDUISM
  BUDDHISM
  CONFUCIANISM
  OTHER
}

enum StudentStatus {
  REGISTERED
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

// Drives digit 4 of the auto-generated NIS (0=PRE_K, 1=PSB, 2=TRANSFER).
enum StudentEntryType {
  PRE_K
  PSB
  TRANSFER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
