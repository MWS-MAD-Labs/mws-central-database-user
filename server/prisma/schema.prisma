model AdminUser {
  id        String    @id @default(cuid())
  admin_no  Int       @unique @default(autoincrement())
  email     String    @unique
  full_name String
  role      AdminRole @default(VIEWER)

  // Stable employee link that does not depend on email.
  // Nullable for older rows that could not be matched during backfill.
  person_id String? @unique
  person    Person? @relation(fields: [person_id], references: [id])

  unit_id String
  unit    MasterUnit @relation(fields: [unit_id], references: [id])

  // Set only by a protected Super Admin; see change-request-approver.ts.
  can_approve_identifier_changes      Boolean   @default(false)
  can_view_sensitive_data             Boolean   @default(false)
  // Widens student_view_units/employee_view_units to every unit - each is
  // independent, e.g. an admin can be all-units for employees but custom-
  // scoped for students. See AdminUserStudentViewUnit's own comment for the
  // custom-scope convention.
  can_view_all_student_units          Boolean   @default(false)
  can_view_all_employee_units         Boolean   @default(false)
  can_view_employee_pii               Boolean   @default(false)
  can_view_student_data               Boolean   @default(false)
  can_view_employee_data              Boolean   @default(false)
  can_view_employee_disciplinary_data Boolean   @default(false)
  can_manage_enrollments              Boolean   @default(false)
  can_manage_teacher_assignments      Boolean   @default(false)
  // Class writes use student permission; teacher assignments use employee permission.
  can_write_employee_data             Boolean   @default(false)
  can_write_student_data              Boolean   @default(false)
  after_hours_write_until             DateTime?

  google_id          String?   @unique
  // Last-seen Google avatar URL - compared on login to skip re-downloading
  // and re-uploading an unchanged photo. The actual served photo is cached
  // in MinIO via avatar_object_key (see resolvePersonPhotoUrl).
  avatar_url         String?
  avatar_object_key  String?
  is_active          Boolean   @default(true)
  last_login         DateTime?
  refresh_token_hash String?   @unique
  refresh_token_exp  DateTime?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  audit_logs                         AuditLog[]
  disciplinary_actions_issued        EmployeeDisciplinaryAction[]
  identifier_change_requests_made    IdentifierChangeRequest[]    @relation("IdentifierChangeRequester")
  identifier_change_requests_decided IdentifierChangeRequest[]    @relation("IdentifierChangeDecider")

  student_view_units  AdminUserStudentViewUnit[]
  employee_view_units AdminUserEmployeeViewUnit[]

  @@map("admin_users")
}

// Custom student-data unit scope for a DATABASE_ADMIN, used only when
// can_view_all_student_units is false - deliberately the opposite default
// from unit-scoping elsewhere (e.g. MasterJobLevelUnit): empty means "their
// own unit only" (today's unchanged behavior), non-empty means "restricted
// to exactly these listed units". Mirrors EmployeePcMentorUnit's convention.
model AdminUserStudentViewUnit {
  admin_id String
  unit_id  String
  admin    AdminUser  @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  unit     MasterUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([admin_id, unit_id])
  @@map("admin_user_student_view_units")
}

// Employee-data counterpart of AdminUserStudentViewUnit - independent scope,
// same empty-means-own-unit-only convention.
model AdminUserEmployeeViewUnit {
  admin_id String
  unit_id  String
  admin    AdminUser  @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  unit     MasterUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([admin_id, unit_id])
  @@map("admin_user_employee_view_units")
}

