// No mentor_id here - the mentor shown for an assignment is always the
// live PCActivityDefaultMentor for (activity_id, student's current unit),
// resolved at read time (see PCActivityService.resolveMentorForActivity).
// Never stored per-row, so changing a unit's default retroactively updates
// every existing assignment's displayed mentor - it's a relation, not a
// snapshot.
model PassionConnectionActivity {
  id               String           @id @default(cuid())
  student_id       String
  student          Student          @relation(fields: [student_id], references: [id])
  day              PCDay
  activity_id      String
