// Mentor is resolved from the student's current unit at read time.
// Changing a unit default affects existing assignments.
enum PcActivityAssignmentStatus {
  ACTIVE
  SCHEDULED
  EXPIRED
  ENDED
}

model PassionConnectionActivity {
  id               String           @id @default(cuid())
  student_id       String
  student          Student          @relation(fields: [student_id], references: [id])
  day              PCDay
  activity_id      String
  activity         MasterPCActivity @relation(fields: [activity_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear     @relation(fields: [academic_year_id], references: [id])
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
  deleted_at       DateTime?

  // Null for legacy rows migrated before rooms existed with no room to
  // attribute them to - surfaced as-is, never invented.
  room_id String?
  room    PcActivityRoom? @relation(fields: [room_id], references: [id], onDelete: SetNull)

  // Distinct from created_at - when this specific assignment period
  // started, used to compute expires_at from the room's duration_type.
  start_date DateTime                   @default(now())
  expires_at DateTime?
  end_date   DateTime?
  // Flipped ACTIVE -> EXPIRED by a sweep job when expires_at passes -
  // never auto-deletes or auto-reassigns, an admin decides what's next.
  // This row IS the assignment's history - no separate mutation log.
  status     PcActivityAssignmentStatus @default(ACTIVE)

  previous_assignment_id String?                    @unique
  previous_assignment    PassionConnectionActivity? @relation("PcActivityStudentAssignmentChain", fields: [previous_assignment_id], references: [id])
  next_assignment        PassionConnectionActivity? @relation("PcActivityStudentAssignmentChain")

  // One current room per student, academic year, and day.
  // Enforced by a partial unique index on (student_id, academic_year_id, day)
  // WHERE deleted_at IS NULL AND status IN ('ACTIVE', 'SCHEDULED'), in the migration.
  @@index([room_id, deleted_at, status, start_date])
  @@map("passion_connection_activities")
}

model AcademicYear {
  id         String             @id @default(cuid())
  name       String             @unique
  start_date DateTime
  end_date   DateTime?
  status     AcademicYearStatus @default(UPCOMING)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  classes                  Class[]
  enrollments              StudentClassEnrollment[]
  students_joined          Student[]                   @relation("StudentJoinAcademicYear")
  pc_activities            PassionConnectionActivity[]
  pc_activity_rooms        PcActivityRoom[]
  student_mutation_history StudentMutationHistory[]    @relation("StudentMutationJoinAcademicYear")

  @@map("academic_years")
}

model Grade {
