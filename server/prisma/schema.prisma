model Class {
  id               String       @id @default(cuid())
  name             String
  // Primary/nominal grade - unchanged meaning for a normal single-grade
  // class. For a mixed-age class (see ClassAdditionalGrade below) this is
  // just one of several grades actually taught here, not "the" grade.
  grade_id         String
  grade            Grade        @relation(fields: [grade_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id])
  status           ClassStatus  @default(ACTIVE)
  capacity         Int?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  current_students    Student[]                @relation("CurrentClass")
  enrollments         StudentClassEnrollment[]
  teacher_assignments ClassTeacherAssignment[]
  additional_grades   ClassAdditionalGrade[]

  @@unique([name, academic_year_id])
  @@map("classes")
}

// Extra grades a class accepts on top of its primary grade_id - deliberately
// additive (grade_id keeps its existing single-grade meaning for the 99% of
// classes that only ever teach one grade) rather than replacing Class-Grade
// with a many-to-many everywhere. Real-world case: a Kindergarten section
// (e.g. "K - Mauna Kea") is one physical mixed-age classroom actually
// teaching Pre-K, K1, and K2 kids together under one homeroom teacher -
// the product spec (9.2) only documents a single "Grade Level" per class,
// but this is a confirmed real requirement it didn't anticipate.
model ClassAdditionalGrade {
  id       String @id @default(cuid())
  class_id String
  class    Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  grade_id String
  grade    Grade  @relation(fields: [grade_id], references: [id])

  @@unique([class_id, grade_id])
  @@map("class_additional_grades")
}

enum ClassTeacherRole {
  HOMEROOM
  SUPPORTING_HOMEROOM
  SUBJECT_TEACHER
}

model ClassTeacherAssignment {
  id          String           @id @default(cuid())
  class_id    String
  class       Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  employee_id String
  employee    Employee         @relation(fields: [employee_id], references: [id])
  role        ClassTeacherRole @default(HOMEROOM)
  // A class can have several simultaneous active assignments per role
  // (multiple HOMEROOM/SUPPORTING_HOMEROOM/SUBJECT_TEACHER rows). What's
  // capped is per-employee: for HOMEROOM and SUPPORTING_HOMEROOM, one
  // employee can only hold one active assignment of that role per academic
  // year (app-level check, see assertTeacherNotAlreadyAssignedThisRoleElsewhere
  // in class-service.ts - not a DB constraint). SUBJECT_TEACHER has no cap
  // in either direction (e.g. one music teacher across several grades).
  // subject is only meaningful for SUBJECT_TEACHER (e.g. "Visual Arts").
  subject     String?
  start_date  DateTime         @default(now())
  end_date    DateTime?
  created_at  DateTime         @default(now())
  // Set when an assignment is removed as a mistake correction (wrong class/employee
  // entered), distinct from end_date which closes a legitimately-finished assignment.
  deleted_at  DateTime?

  @@map("class_teacher_assignments")
}

enum StudentSupportRole {
  SPECIAL_ED
}

// Follows a specific student, not a class - e.g. a Special Ed teacher works
// with named students individually, potentially across several classes/
// grades, unlike ClassTeacherAssignment above which is scoped to a class.
model StudentSupportAssignment {
  id          String             @id @default(cuid())
  student_id  String
  student     Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  employee_id String
  employee    Employee           @relation(fields: [employee_id], references: [id])
  role        StudentSupportRole @default(SPECIAL_ED)
  notes       String?
  start_date  DateTime           @default(now())
  end_date    DateTime?
  created_at  DateTime           @default(now())

  @@map("student_support_assignments")
}

model StudentClassEnrollment {
  id                          String                   @id @default(cuid())
  student_id                  String
  student                     Student                  @relation(fields: [student_id], references: [id])
  academic_year_id            String
  academic_year               AcademicYear             @relation(fields: [academic_year_id], references: [id])
  class_id                    String
  class                       Class                    @relation(fields: [class_id], references: [id])
  grade_level                 String
  // Actual grade this specific enrollment is in - for a normal single-grade
  // class this always equals class.grade_id, but a mixed-age class (see
  // ClassAdditionalGrade) can hold students from several grades at once, so
  // the enrollment has to carry its own resolved grade rather than assuming
  // the class's primary one.
  grade_id                    String
  grade                       Grade                    @relation(fields: [grade_id], references: [id])
  class_name_snapshot         String
  enrollment_status           EnrollmentStatus         @default(ACTIVE)
  start_date                  DateTime?
  end_date                    DateTime?
  // Set when this enrollment re-enters the same or a lower grade than the
  // student's previous one (see assertValidGradeProgression) - lets history
  // views distinguish a repeat year from a normal promotion.
  is_retention                Boolean                  @default(false)
  retention_reason            String?
  // Set only by create()'s is_legacy path - the Historical Data seed record
  // reconstructing a student's history one year at a time. Lets a later
  // plain create() reject once one of these is sitting ACTIVE and unpromoted
  // (see EnrollmentService.create) instead of silently creating a second,
  // disconnected ACTIVE enrollment - that record's only valid next step is
  // Promote, never another create().
  is_legacy                   Boolean                  @default(false)
  // Set by promote() on the newly-created row, pointing at the enrollment it
  // was promoted from. Lets remove() find "the one to reactivate" directly
  // instead of guessing from matching dates when dropping a promoted
  // enrollment, and lets the API tell the frontend whether an enrollment is
  // rollback-eligible (Rollback) or a first enrollment (Drop).
  promoted_from_enrollment_id String?
  promoted_from               StudentClassEnrollment?  @relation("EnrollmentPromotion", fields: [promoted_from_enrollment_id], references: [id])
  promoted_to                 StudentClassEnrollment[] @relation("EnrollmentPromotion")
  created_at                  DateTime                 @default(now())
  updated_at                  DateTime                 @updatedAt
  deleted_at                  DateTime?

  // Uniqueness on (student_id, academic_year_id) enforced by a partial index in the migration.
  @@index([promoted_from_enrollment_id])
  @@map("student_class_enrollments")
}

