model MasterUnit {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  admin_users AdminUser[]

  grades Grade[]

  mutation_history EmployeeMutationHistory[]

  pc_activity_default_mentors         PCActivityDefaultMentor[]
  pc_activity_mentor_mutation_history PCActivityMentorMutationHistory[]
  intern_mutation_history             InternMutationHistory[]

  job_position_units     MasterJobPositionUnit[]
  job_level_units        MasterJobLevelUnit[]
  pc_activity_units      MasterPCActivityUnit[]
  pc_activity_room_units PcActivityRoomUnit[]

  employee_pc_mentor_units EmployeePcMentorUnit[]
  intern_pc_mentor_units   InternPcMentorUnit[]

  admin_student_view_units  AdminUserStudentViewUnit[]
  admin_employee_view_units AdminUserEmployeeViewUnit[]

  @@map("master_units")
}

model MasterJobPosition {
  id                          String                 @id @default(cuid())
  name                        String                 @unique
  is_teaching_position        Boolean                @default(false)
  is_homeroom_position        Boolean                @default(false)
  is_subject_teacher_position Boolean                @default(false)
  capacity_scope              PositionCapacityScope?
  max_active_holders          Int?
  created_at                  DateTime               @default(now())
  updated_at                  DateTime               @updatedAt

  // Empty allows this position in any unit; rows restrict it to listed units.
  units MasterJobPositionUnit[]

  employees Employee[]
  interns   Intern[]

  mutation_history        EmployeeMutationHistory[]
  intern_mutation_history InternMutationHistory[]

  @@map("master_job_positions")
}

model MasterJobPositionUnit {
  job_position_id String
  unit_id         String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id], onDelete: Cascade)
  unit            MasterUnit        @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([job_position_id, unit_id])
  @@map("master_job_position_units")
}

model MasterJobLevel {
  id               String   @id @default(cuid())
  name             String   @unique
  is_teaching_role Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  // Empty allows this level in any unit; rows restrict it to listed units.
  units MasterJobLevelUnit[]

  employees Employee[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_job_levels")
}

model MasterJobLevelUnit {
  job_level_id String
  unit_id      String
  job_level    MasterJobLevel @relation(fields: [job_level_id], references: [id], onDelete: Cascade)
  unit         MasterUnit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([job_level_id, unit_id])
  @@map("master_job_level_units")
}

model MasterBuilding {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  mutation_history        EmployeeMutationHistory[]
  intern_mutation_history InternMutationHistory[]

  @@map("master_buildings")
}

model MasterPCActivity {
  id                      String                            @id @default(cuid())
  name                    String                            @unique
  created_at              DateTime                          @default(now())
  updated_at              DateTime                          @updatedAt
  pc_activities           PassionConnectionActivity[]
  default_mentors         PCActivityDefaultMentor[]
  mentor_mutation_history PCActivityMentorMutationHistory[]
  units                   MasterPCActivityUnit[]
  rooms                   PcActivityRoom[]

  @@map("master_pc_activities")
}

// Legacy scope retained for existing data. New room flows do not use it.
model MasterPCActivityUnit {
  activity_id String
  unit_id     String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  unit        MasterUnit       @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([activity_id, unit_id])
  @@map("master_pc_activity_units")
}

enum PcActivityRoomDurationType {
  SIX_MONTHS
  HALF_SEMESTER
  SEMESTER
  FULL_YEAR
  CUSTOM
}

enum PcActivityMentorAssignmentStatus {
  ACTIVE
  SCHEDULED
  ENDED
}

// A PC room is scoped to unit(s) + grade(s), not to a single class - any
// active student in those grades/units is eligible regardless of which
// class they're actually in. Replaces the old per-class offering
// (ClassPassionConnectionActivity).
model PcActivityRoom {
  id                   String                     @id @default(cuid())
  // Optional suffix. The display name is activity name + label.
  label                String?
  activity_id          String
  activity             MasterPCActivity           @relation(fields: [activity_id], references: [id])
  academic_year_id     String
  academic_year        AcademicYear               @relation(fields: [academic_year_id], references: [id])
  day                  PCDay
  duration_type        PcActivityRoomDurationType
  custom_duration_days Int?
  start_date           DateTime
  end_date             DateTime
  created_by           String
  created_at           DateTime                   @default(now())
  updated_at           DateTime                   @updatedAt
  deleted_at           DateTime?

  units         PcActivityRoomUnit[]
  grades        PcActivityRoomGrade[]
  classes       PcActivityRoomClass[]
  mentors       PcActivityRoomMentorAssignment[]
  student_links PassionConnectionActivity[]

  @@map("pc_activity_rooms")
}

// A room must have at least one unit (enforced app-side at create) -
// unlike MasterPCActivityUnit, "any unit" isn't a sensible default here.
model PcActivityRoomUnit {
  room_id String
  unit_id String
  room    PcActivityRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  unit    MasterUnit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([room_id, unit_id])
  @@map("pc_activity_room_units")
}

// Empty allows any grade within the room's selected unit(s); rows
// restrict it to listed grades. Every listed grade must belong to one of
// the room's own units (enforced app-side).
model PcActivityRoomGrade {
  room_id  String
  grade_id String
  room     PcActivityRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  grade    Grade          @relation(fields: [grade_id], references: [id], onDelete: Restrict)

  @@id([room_id, grade_id])
  @@map("pc_activity_room_grades")
}

// Empty allows any eligible class in the room's academic year.
model PcActivityRoomClass {
  room_id  String
  class_id String
  room     PcActivityRoom @relation(fields: [room_id], references: [id], onDelete: Cascade)
  class    Class          @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@id([room_id, class_id])
  @@map("pc_activity_room_classes")
}

// Many independent concurrent rows per room (no unique on room_id alone)
// is what makes multiple mentors per room possible - mirrors
// ClassTeacherAssignment's shape, not PCActivityDefaultMentor's
// one-value-per-slot chain. end_date closes a row in place; deleted_at is
// a separate soft-delete for mistake correction.
model PcActivityRoomMentorAssignment {
  id          String                           @id @default(cuid())
  room_id     String
  room        PcActivityRoom                   @relation(fields: [room_id], references: [id], onDelete: Cascade)
  employee_id String?
  employee    Employee?                        @relation(fields: [employee_id], references: [id])
  intern_id   String?
  intern      Intern?                          @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  start_date  DateTime                         @default(now())
  end_date    DateTime?
  status      PcActivityMentorAssignmentStatus @default(ACTIVE)
  created_at  DateTime                         @default(now())
  deleted_at  DateTime?

  previous_assignment_id String?                         @unique
  previous_assignment    PcActivityRoomMentorAssignment? @relation("PcActivityRoomMentorAssignmentChain", fields: [previous_assignment_id], references: [id])
  next_assignment        PcActivityRoomMentorAssignment? @relation("PcActivityRoomMentorAssignmentChain")

  @@index([room_id, deleted_at, status, start_date])
  @@index([employee_id, deleted_at, status])
  @@index([intern_id, deleted_at, status])
  @@map("pc_activity_room_mentor_assignments")
}

// Legacy suggestion data. Room mentorships are authoritative for new flows.
model PCActivityDefaultMentor {
  id          String           @id @default(cuid())
  activity_id String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id])
  unit_id     String
  unit        MasterUnit       @relation(fields: [unit_id], references: [id])
  mentor_id   String?
  mentor      Employee?        @relation(fields: [mentor_id], references: [id])
  intern_id   String?
  intern      Intern?          @relation(fields: [intern_id], references: [id], onDelete: Restrict)
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@unique([activity_id, unit_id])
  @@map("pc_activity_default_mentors")
}

model PCActivityMentorMutationHistory {
  id                  String                           @id @default(cuid())
  activity_id         String
  activity            MasterPCActivity                 @relation(fields: [activity_id], references: [id])
  unit_id             String
  unit                MasterUnit                       @relation(fields: [unit_id], references: [id])
  mentor_id           String?
  mentor              Employee?                        @relation(fields: [mentor_id], references: [id])
  intern_id           String?
  intern              Intern?                          @relation(fields: [intern_id], references: [id])
  start_date          DateTime
  end_date            DateTime?
  previous_history_id String?                          @unique
  previous_history    PCActivityMentorMutationHistory? @relation("PCActivityMentorMutationChain", fields: [previous_history_id], references: [id])
  next_history        PCActivityMentorMutationHistory? @relation("PCActivityMentorMutationChain")
  created_at          DateTime                         @default(now())
  deleted_at          DateTime?

  @@map("pc_activity_mentor_mutation_histories")
}

// Suggestion values only; employee education fields remain free text.
model MasterInstitution {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_institutions")
}

model MasterMajor {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_majors")
}

model Person {
  id               String     @id @default(cuid())
  full_name        String
  nick_name        String
  email            String     @unique
  person_type      PersonType
  gender           Gender
  religion         Religion
  // Set for an explicit OTHER religion; null may indicate a legacy placeholder.
  religion_other   String?
  birth_place      String
  birth_date       DateTime
  // Legacy external photo URL used when photo_object_key is unset.
  photo_url        String?
  // Private object key. Presigned URLs are generated on read and never stored.
  photo_object_key String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  student   Student?
  employee  Employee?
  adminUser AdminUser?

  application_entitlements ApplicationEntitlement[]

  @@map("persons")
}

model Student {
  id                                String           @id @default(cuid())
  person_id                         String           @unique
  person                            Person           @relation(fields: [person_id], references: [id])
  // Invalid legacy values stay in legacy_nis until a valid NIS is issued.
  nis                               String?          @unique
  legacy_nis                        String?
  // Invalid legacy values stay in legacy_nisn instead of blocking import.
  nisn                              String?          @unique
  legacy_nisn                       String?
  status                            StudentStatus    @default(REGISTERED)
  pre_delete_status                 StudentStatus?
  current_grade_id                  String
  current_grade                     Grade            @relation("StudentCurrentGrade", fields: [current_grade_id], references: [id])
  current_class_id                  String?
  current_class                     Class?           @relation("CurrentClass", fields: [current_class_id], references: [id])
  join_academic_year_id             String
  join_academic_year                AcademicYear     @relation("StudentJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  join_grade_id                     String
  join_grade                        Grade            @relation("StudentJoinGrade", fields: [join_grade_id], references: [id])
  graduation_grade                  String?
  previous_school                   String?
  leave_year                        String?
  // Legacy SN values are booleans from the source sheet.
  sn                                Boolean          @default(false)
  pickup_drop_service               Boolean          @default(false)
  catering_service                  Boolean          @default(false)
  psb_guide                         Boolean          @default(false)
  // The database default only backfills existing rows; creates require this field.
  entry_type                        StudentEntryType @default(PSB)
  // Tracks fields filled with placeholders during legacy import.
  // Updating a tracked field removes its key.
  import_defaulted_fields           String[]         @default([])
  // Records an approved join-grade mismatch and clears when either grade changes.
  grade_consistency_override_reason String?
  created_at                        DateTime         @default(now())
  updated_at                        DateTime         @updatedAt
  deleted_at                        DateTime?

  parents             ParentGuardian[]
  enrollments         StudentClassEnrollment[]
  consents            ConsentRecord[]
  health              HealthRecord?
  health_notes        HealthNote[]
  pc                  PassionConnectionActivity[]
  vaccine_records     VaccineRecord[]
  support_assignments StudentSupportAssignment[]
  mutation_history    StudentMutationHistory[]

  @@map("students")
}

model Employee {
  id              String         @id @default(cuid())
  person_id       String         @unique
  person          Person         @relation(fields: [person_id], references: [id])
  employee_id     String         @unique
  status          EmployeeStatus @default(ACTIVE)
  employment_type EmploymentType

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  job_level_id    String
  job_level       MasterJobLevel    @relation(fields: [job_level_id], references: [id])

  building_id           String
  building              MasterBuilding         @relation(fields: [building_id], references: [id])
  join_date             DateTime
  // Planned expiry for contract employees, separate from last_working_date.
  contract_end_date     DateTime?
  // Planned or actual last day. It does not change status automatically.
  last_working_date     DateTime?
  notes                 String?
  is_pc_mentor_eligible Boolean                @default(false)
  // Deliberately the opposite default from MasterJobLevelUnit/
  // MasterJobPositionUnit's "empty means unrestricted": empty here means
  // "their own unit only" (today's behavior, unchanged) - rows widen or
  // redirect eligibility to specific unit(s) instead, which may or may not
  // include their own.
  pc_mentor_units       EmployeePcMentorUnit[]

  mobile_phone           String?
  residential_address    String?
  marital_status         MaritalStatus
  // Stores only the highest or most recent education record.
  education_level        EducationLevel?
  institution_name       String?
  major                  String?
  graduation_year        Int?
  // Sensitive identifiers are cleared on soft delete and retained in the audit log.
  nik                    String?         @unique
  npwp                   String?         @unique
  bank_account_number    String?         @unique
  // BPJS Kesehatan (health insurance program) - 13 digits.
  bpjs_number            String?         @unique
  // BPJS Ketenagakerjaan identifier, separate from bpjs_number, 11 digits.
  bpjs_employment_number String?         @unique
  // Legacy KPJ identifier. It may be alphanumeric and is distinct from BPJS employment.
  kpj_number             String?         @unique

  // These timestamps anchor the identifier edit window.
  // Null values fall back to created_at for compatibility.
  nik_set_at                    DateTime?
  npwp_set_at                   DateTime?
  bank_account_number_set_at    DateTime?
  bpjs_number_set_at            DateTime?
  bpjs_employment_number_set_at DateTime?
  kpj_number_set_at             DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  class_assignments                   ClassTeacherAssignment[]
  student_assignments                 StudentSupportAssignment[]
  pc_activity_default_mentor_for      PCActivityDefaultMentor[]
  pc_activity_mentor_mutation_history PCActivityMentorMutationHistory[]
  pc_activity_room_mentor_assignments PcActivityRoomMentorAssignment[]
  mutation_history                    EmployeeMutationHistory[]
  disciplinary_actions                EmployeeDisciplinaryAction[]

  @@map("employees")
}

model EmployeePcMentorUnit {
  employee_id String
  unit_id     String
  employee    Employee   @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  unit        MasterUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([employee_id, unit_id])
  @@map("employee_pc_mentor_units")
}

// Interns stay separate from Person because their required identity data differs.
model Intern {
  id        String @id @default(cuid())
  full_name String
  nick_name String
  email     String @unique

  gender         Gender
  religion       Religion
  religion_other String?
  birth_place    String?
  birth_date     DateTime?

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  building_id     String
  building        MasterBuilding    @relation(fields: [building_id], references: [id])

  status                InternStatus         @default(ACTIVE)
  join_date             DateTime
  end_date              DateTime
  notes                 String?
  is_pc_mentor_eligible Boolean              @default(false)
  // Same deliberate default-flip as Employee.pc_mentor_units - empty means
  // "their own unit only", not unrestricted.
  pc_mentor_units       InternPcMentorUnit[]

  mobile_phone        String?
  residential_address String?

  education_level  EducationLevel?
  institution_name String?
  major            String?
  graduation_year  Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  class_assignments                   ClassTeacherAssignment[]
  student_assignments                 StudentSupportAssignment[]
  pc_activity_default_mentor_for      PCActivityDefaultMentor[]
  pc_activity_mentor_mutation_history PCActivityMentorMutationHistory[]
  pc_activity_room_mentor_assignments PcActivityRoomMentorAssignment[]
  mutation_history                    InternMutationHistory[]

  @@map("interns")
}

model InternPcMentorUnit {
  intern_id String
  unit_id   String
  intern    Intern     @relation(fields: [intern_id], references: [id], onDelete: Cascade)
  unit      MasterUnit @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@id([intern_id, unit_id])
  @@map("intern_pc_mentor_units")
}

enum EmployeeMutationField {
  UNIT
  JOB_POSITION
  JOB_LEVEL
  BUILDING
  STATUS
  EMPLOYMENT_TYPE
}

enum InternMutationField {
  UNIT
  JOB_POSITION
  BUILDING
  STATUS
}

model InternMutationHistory {
  id        String              @id @default(cuid())
  intern_id String
  intern    Intern              @relation(fields: [intern_id], references: [id])
  field     InternMutationField

  unit_id         String?
  unit            MasterUnit?        @relation(fields: [unit_id], references: [id])
  job_position_id String?
  job_position    MasterJobPosition? @relation(fields: [job_position_id], references: [id])
  building_id     String?
  building        MasterBuilding?    @relation(fields: [building_id], references: [id])
  status          InternStatus?

  start_date DateTime
  end_date   DateTime?

  previous_history_id String?                @unique
  previous_history    InternMutationHistory? @relation("InternMutationChain", fields: [previous_history_id], references: [id])
  next_history        InternMutationHistory? @relation("InternMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("intern_mutation_histories")
}

// Tracks separate value periods for each employee field.
// The open row has no end_date; rollback reopens its predecessor.
model EmployeeMutationHistory {
  id          String                @id @default(cuid())
  employee_id String
  employee    Employee              @relation(fields: [employee_id], references: [id])
  field       EmployeeMutationField

  // Exactly one of these six is set, matching `field`.
  unit_id         String?
  unit            MasterUnit?        @relation(fields: [unit_id], references: [id])
  job_position_id String?
  job_position    MasterJobPosition? @relation(fields: [job_position_id], references: [id])
  job_level_id    String?
  job_level       MasterJobLevel?    @relation(fields: [job_level_id], references: [id])
  building_id     String?
  building        MasterBuilding?    @relation(fields: [building_id], references: [id])
  status          EmployeeStatus?
  employment_type EmploymentType?

  start_date DateTime
  end_date   DateTime?

  // @unique keeps Prisma's one-to-one shape; the database uses a partial unique index.
  // Preserve the partial index so rolled-back values can be reused.
  previous_history_id String?                  @unique
  previous_history    EmployeeMutationHistory? @relation("EmployeeMutationChain", fields: [previous_history_id], references: [id])
  next_history        EmployeeMutationHistory? @relation("EmployeeMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("employee_mutation_histories")
}

enum StudentMutationField {
  JOIN_GRADE
  JOIN_ACADEMIC_YEAR
  ENTRY_TYPE
  CURRENT_CLASS
  CURRENT_GRADE
}

// Tracks value periods for student fields not covered by enrollment history.
model StudentMutationHistory {
  id         String               @id @default(cuid())
  student_id String
  student    Student              @relation(fields: [student_id], references: [id])
  field      StudentMutationField

  // Exactly one of these is set, matching `field`.
  join_grade_id         String?
  join_grade            Grade?            @relation("StudentMutationJoinGrade", fields: [join_grade_id], references: [id])
  join_academic_year_id String?
  join_academic_year    AcademicYear?     @relation("StudentMutationJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  entry_type            StudentEntryType?
  // CURRENT_CLASS - recorded by EnrollmentService.transfer(), the one enrollment
  // mutation that updates the same enrollment row in place instead of closing it
  // and creating a new one, so it has no other history trail.
  class_id              String?
  class                 Class?            @relation("StudentMutationClass", fields: [class_id], references: [id])
  // CURRENT_GRADE - recorded only when current_grade_id changes outside enrollment
  // history (student has no enrollment record yet); promote()/transfer() keep
  // current_grade in sync with enrollment rows, which are already their own history.
  current_grade_id      String?
  current_grade         Grade?            @relation("StudentMutationCurrentGrade", fields: [current_grade_id], references: [id])

  // Snapshot used to restore the grade override reason during rollback.
  grade_consistency_override_reason String?

  start_date DateTime
  end_date   DateTime?

  // @unique keeps Prisma's one-to-one shape; the database uses a partial unique index.
  // Preserve the partial index so rolled-back values can be reused.
  previous_history_id String?                 @unique
  previous_history    StudentMutationHistory? @relation("StudentMutationChain", fields: [previous_history_id], references: [id])
  next_history        StudentMutationHistory? @relation("StudentMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("student_mutation_histories")
}

enum DisciplinaryActionType {
  SURAT_TEGURAN
  SURAT_PERINGATAN
}

enum DisciplinaryActionStatus {
  ACTIVE
  EXPIRED
  RESOLVED
  REVOKED
  SUPERSEDED
}

// Issued actions are immutable except for status.
// Only one active action is allowed per employee and type.
model EmployeeDisciplinaryAction {
