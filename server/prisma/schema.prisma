model MasterUnit {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  admin_users AdminUser[]

  grades Grade[]

  mutation_history EmployeeMutationHistory[]

  pc_activity_default_mentors PCActivityDefaultMentor[]

  @@map("master_units")
}

model MasterJobPosition {
  id                   String   @id @default(cuid())
  name                 String   @unique
  is_teaching_position Boolean  @default(false)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_job_positions")
}

model MasterJobLevel {
  id               String   @id @default(cuid())
  name             String   @unique
  is_teaching_role Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  employees Employee[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_job_levels")
}

model MasterBuilding {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  employees Employee[]
  interns   Intern[]

  mutation_history EmployeeMutationHistory[]

  @@map("master_buildings")
}

model MasterPCActivity {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pc_activities   PassionConnectionActivity[]
  default_mentors PCActivityDefaultMentor[]

  @@map("master_pc_activities")
}

// Pre-fills PassionConnectionActivity.mentor_id when a student is assigned
// this activity and no mentor is explicitly chosen - still overridable per
// assignment, this is just the starting suggestion. Scoped per unit (not a
// single mentor_id on MasterPCActivity) because the same activity name can
// have a different default mentor in each unit (e.g. Elementary's Chess
// Club coach isn't Junior High's) - one row per (activity, unit) that
// actually has a default; no row means no suggestion for that unit.
model PCActivityDefaultMentor {
  id          String           @id @default(cuid())
  activity_id String
  activity    MasterPCActivity @relation(fields: [activity_id], references: [id])
  unit_id     String
  unit        MasterUnit       @relation(fields: [unit_id], references: [id])
  mentor_id   String
  mentor      Employee         @relation(fields: [mentor_id], references: [id])
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  @@unique([activity_id, unit_id])
  @@map("pc_activity_default_mentors")
}

// Canonical, admin-editable suggestion lists for Employee.institution_name/
// major - those stay free-text columns (not FKs), so fixing a typo here
// doesn't retroactively change existing employee records, only future
// suggestions. Kept lightweight on purpose: an employee's education history
// can reference an institution/major that hasn't been added here yet.
model MasterInstitution {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_institutions")
}

model MasterMajor {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("master_majors")
}

// Models

model Person {
  id               String     @id @default(cuid())
  full_name        String
  nick_name        String
  email            String     @unique
  person_type      PersonType
  gender           Gender
  religion         Religion
  // Only meaningful when religion = OTHER - free text for what it
  // actually is (e.g. "Baha'i", "Sikh"). Distinguishes a real "Other"
  // answer from OTHER as a legacy-import placeholder (see
  // ImportValidation.mapRow) with nothing entered, which otherwise look
  // identical on this enum alone.
  religion_other   String?
  birth_place      String
  birth_date       DateTime
  // Legacy - a raw external URL (mostly Google Drive links from the old
  // spreadsheet). Falls back to this only when photo_object_key is unset.
  photo_url        String?
  // MinIO object key for an uploaded photo (resized + converted to WebP on
  // upload - see StudentPhotoService). The bucket is private; a presigned
  // URL is generated on read, never stored, since a stored one would go
  // stale. Reuses the existing photo_url field name in API responses -
  // callers don't need to know which source it came from.
  photo_object_key String?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  deleted_at       DateTime?

  student  Student?
  employee Employee?

  @@map("persons")
}

model Student {
  id                    String           @id @default(cuid())
  person_id             String           @unique
  person                Person           @relation(fields: [person_id], references: [id])
  // Nullable to support legacy imports whose old NIS doesn't match the
  // strict pattern - legacy_nis preserves the original value, nis gets
  // backfilled later via StudentService.reissueNis().
  nis                   String?          @unique
  legacy_nis            String?
  // Same reasoning as nis/legacy_nis - a legacy NISN that isn't exactly 10
  // digits is preserved here instead of blocking the import row.
  nisn                  String?          @unique
  legacy_nisn           String?
  status                StudentStatus    @default(REGISTERED)
  pre_delete_status     StudentStatus?
  current_grade_id      String
  current_grade         Grade            @relation("StudentCurrentGrade", fields: [current_grade_id], references: [id])
  current_class_id      String?
  current_class         Class?           @relation("CurrentClass", fields: [current_class_id], references: [id])
  join_academic_year_id String
  join_academic_year    AcademicYear     @relation("StudentJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  join_grade_id         String
  join_grade            Grade            @relation("StudentJoinGrade", fields: [join_grade_id], references: [id])
  graduation_grade      String?
  previous_school       String?
  leave_year            String?
  // The old report-card sheet's "SN" column is a checkbox (TRUE/FALSE), not
  // free text - matches pickup_drop_service/catering_service/psb_guide below.
  sn                    Boolean          @default(false)
  pickup_drop_service   Boolean          @default(false)
  catering_service      Boolean          @default(false)
  psb_guide             Boolean          @default(false)
  // DB-level default only covers the migration on pre-existing rows - the
  // Zod create schema requires this explicitly for every new student.
  entry_type            StudentEntryType @default(PSB)
  // Which fields (by key: "religion", "birth_place", "birth_date", "status")
  // a legacy import couldn't find on the sheet and silently filled with a
  // placeholder at create time - surfaced on the detail page so it stays
  // findable after the fact, not just during that one import's preview.
  // StudentService.update() removes an entry the moment that same field is
  // actually updated, so the flag clears itself once the real value is in.
  import_defaulted_fields String[]       @default([])
  // Reason a Super Admin gave to let a "too far ahead" or "behind join
  // grade" consistency check through at create time instead of blocking the
  // row - surfaced on the detail page next to Current/Join Grade so the
  // mismatch reads as a known, explained exception rather than a bug.
  // Cleared by StudentService.update() the moment either grade is actually
  // changed, same self-clearing convention as import_defaulted_fields.
  grade_consistency_override_reason String?
  created_at            DateTime         @default(now())
  updated_at            DateTime         @updatedAt
  deleted_at            DateTime?

  parents             ParentGuardian[]
  enrollments         StudentClassEnrollment[]
  consents            ConsentRecord[]
  health              HealthRecord?
  health_notes        HealthNote[]
  pc                  PassionConnectionActivity[]
  vaccine_records     VaccineRecord[]
  support_assignments StudentSupportAssignment[]
  mutation_history    StudentMutationHistory[]

  @@map("students")
}

model Employee {
  id              String         @id @default(cuid())
  person_id       String         @unique
  person          Person         @relation(fields: [person_id], references: [id])
  employee_id     String         @unique
  status          EmployeeStatus @default(ACTIVE)
  employment_type EmploymentType

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  job_level_id    String
  job_level       MasterJobLevel    @relation(fields: [job_level_id], references: [id])

  building_id       String
  building          MasterBuilding @relation(fields: [building_id], references: [id])
  join_date         DateTime
  // Planned contract expiry (relevant when employment_type = CONTRACT) -
  // distinct from last_working_date below.
  contract_end_date DateTime?
  // Set when status is RESIGNED - the employee's planned or actual last
  // working day. Status stays ACTIVE (portal access included) until an
  // admin manually flips it to RESIGNED, which is expected to happen on or
  // after this date - EmployeesTable.jsx flags rows where it's overdue.
  last_working_date DateTime?
  notes             String?

  mobile_phone           String?
  residential_address    String?
  marital_status         MaritalStatus
  // Highest/most recent education only - not a history of every degree held.
  education_level        EducationLevel?
  institution_name       String?
  major                  String?
  graduation_year        Int?
  // These identity/sensitive fields are cleared (set to null) when the
  // employee is soft-deleted (see EmployeeService.remove) - that frees the
  // value for someone else if it was a mistaken entry, while the pre-delete
  // value is still preserved in the audit log.
  nik                    String?         @unique
  npwp                   String?         @unique
  bank_account_number    String?         @unique
  // BPJS Kesehatan (health insurance program) - 13 digits.
  bpjs_number            String?         @unique
  // BPJS Ketenagakerjaan (employment/workforce social security program) -
  // a separate program from bpjs_number above, 11 digits.
  bpjs_employment_number String?         @unique
  // Kartu Peserta Jamsostek - the predecessor program to BPJS
  // Ketenagakerjaan. Same 11-character length, but often mixes letters into
  // the digits, unlike the numeric-only bpjs_employment_number. Separate
  // field rather than loosening bpjs_employment_number's format, since a
  // KPJ number is a different-era identifier, not just an old revision of
  // the same one - mirrors students.legacy_nis alongside students.nis.
  kpj_number              String?         @unique

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  class_assignments    ClassTeacherAssignment[]
  student_assignments  StudentSupportAssignment[]
  pc_activity_default_mentor_for PCActivityDefaultMentor[]
  mutation_history     EmployeeMutationHistory[]
  disciplinary_actions EmployeeDisciplinaryAction[]

  @@map("employees")
}

// Lightweight employment record for interns - deliberately its own model,
// not linked to Person at all (unlike Student/Employee). Two reasons:
// 1. Interns don't carry NIK/NPWP/bank/BPJS, job level, or any of the
//    class/student/PC-activity assignment relations Employee has - making
//    those Employee fields nullable to accommodate interns would have
//    weakened the schema's guarantees for every real employee too.
// 2. HR doesn't collect birth_place/birth_date for interns at all - Person
//    requires those NOT NULL for every row regardless of type (shared by
//    Student/Employee, who genuinely need them), so there's no way to make
//    them optional just for interns while Intern still hangs off Person.
//    Interns get their own identity fields instead, with their own
//    required-ness: full_name/nick_name/email/gender/religion stay
//    required (HR does collect these), birth_place/birth_date don't.
model Intern {
  id        String @id @default(cuid())
  full_name String
  nick_name String
  email     String @unique

  gender         Gender
  religion       Religion
  // Only meaningful when religion = OTHER - same meaning as Person's.
  religion_other String?
  birth_place    String?
  birth_date     DateTime?

  unit_id         String
  unit            MasterUnit        @relation(fields: [unit_id], references: [id])
  job_position_id String
  job_position    MasterJobPosition @relation(fields: [job_position_id], references: [id])
  building_id     String
  building        MasterBuilding    @relation(fields: [building_id], references: [id])

  status    InternStatus @default(ACTIVE)
  join_date DateTime
  // Internships are always time-boxed, unlike Employee.contract_end_date
  // which only applies to some employment types.
  end_date DateTime
  notes    String?

  mobile_phone        String?
  residential_address String?

  // Usually still studying, not yet graduated - why they're interning.
  education_level  EducationLevel?
  institution_name String?
  major            String?
  graduation_year  Int?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@map("interns")
}

enum EmployeeMutationField {
  UNIT
  JOB_POSITION
  JOB_LEVEL
  BUILDING
  STATUS
  EMPLOYMENT_TYPE
}

// One row per period an employee held a given value for one tracked field -
// granular per field (not one combined snapshot), so changing unit and job
// level in the same update() call produces two separate rows. Mirrors
// StudentClassEnrollment's promoted_from_enrollment_id chain: each row
// (except the baseline one seeded at create()) links back to the row it
// replaced via previous_history_id, and end_date: null marks the currently
// active row for that field. Rollback = soft-delete the current row, clear
// end_date on the one it points back to (see EmployeeService.rollbackMutation).
model EmployeeMutationHistory {
  id          String                @id @default(cuid())
  employee_id String
  employee    Employee              @relation(fields: [employee_id], references: [id])
  field       EmployeeMutationField

  // Exactly one of these six is set, matching `field`.
  unit_id         String?
  unit            MasterUnit?        @relation(fields: [unit_id], references: [id])
  job_position_id String?
  job_position    MasterJobPosition? @relation(fields: [job_position_id], references: [id])
  job_level_id    String?
  job_level       MasterJobLevel?    @relation(fields: [job_level_id], references: [id])
  building_id     String?
  building        MasterBuilding?    @relation(fields: [building_id], references: [id])
  status          EmployeeStatus?
  employment_type EmploymentType?

  start_date DateTime
  end_date   DateTime?

  // @unique here is declarative only - it exists so Prisma generates the
  // one-to-one relation shape below (next_history: X? rather than X[]).
  // The actual enforced constraint is a PARTIAL unique index scoped to
  // deleted_at IS NULL (see migration
  // 20260827050000_partial_unique_previous_history_id_excludes_deleted) -
  // rollback() soft-deletes rows without freeing this value, so a plain
  // unique index permanently blocks re-editing a field once it's ever been
  // rolled back. `prisma migrate dev` doesn't know about that migration's
  // WHERE clause and will try to regenerate a plain index here - don't
  // accept that; extend the partial-index migration instead.
  previous_history_id String?                  @unique
  previous_history    EmployeeMutationHistory? @relation("EmployeeMutationChain", fields: [previous_history_id], references: [id])
  next_history        EmployeeMutationHistory? @relation("EmployeeMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("employee_mutation_histories")
}

enum StudentMutationField {
  JOIN_GRADE
  JOIN_ACADEMIC_YEAR
  ENTRY_TYPE
}

// One row per period a student held a given value for one tracked field -
// same shape/rollback pattern as EmployeeMutationHistory, scoped to the
// three student fields that AREN'T already covered by enrollment history
// (grade/class/academic year/status live on StudentClassEnrollment instead).
model StudentMutationHistory {
  id         String               @id @default(cuid())
  student_id String
  student    Student              @relation(fields: [student_id], references: [id])
  field      StudentMutationField

  // Exactly one of these three is set, matching `field`.
  join_grade_id         String?
  join_grade            Grade?            @relation("StudentMutationJoinGrade", fields: [join_grade_id], references: [id])
  join_academic_year_id String?
  join_academic_year    AcademicYear?     @relation("StudentMutationJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  entry_type            StudentEntryType?

  start_date DateTime
  end_date   DateTime?

  // Same partial-index caveat as EmployeeMutationHistory.previous_history_id
  // above - see that comment and migration
  // 20260827050000_partial_unique_previous_history_id_excludes_deleted.
  previous_history_id String?                 @unique
  previous_history    StudentMutationHistory? @relation("StudentMutationChain", fields: [previous_history_id], references: [id])
  next_history        StudentMutationHistory? @relation("StudentMutationChain")

  created_at DateTime  @default(now())
  deleted_at DateTime?

  @@map("student_mutation_histories")
}

enum DisciplinaryActionType {
  SURAT_TEGURAN
  SURAT_PERINGATAN
}

enum DisciplinaryActionStatus {
  // Currently in effect - counts toward sequencing/escalation checks.
  ACTIVE
  // Passed valid_until (issued_date + validity_days, admin-chosen per
  // record, default ~6 months) without being resolved -
  // flipped by a periodic sweep, same pattern as employee auto-resign.
  EXPIRED
  // Closed early by an admin before valid_until - issue was addressed.
  RESOLVED
  // Issued by mistake - never should have counted; kept for the audit
  // trail rather than deleted.
  REVOKED
  // Replaced by an escalation (ST1->ST2, SP1->SP2) or made moot by a more
  // severe action (an active ST when SP is issued) - the row this employee
  // is on now is a different one, this one no longer applies.
  SUPERSEDED
}

// One row per Surat Teguran/Peringatan issued to an employee - never
// mutated into a different letter, only its status changes (see
// DisciplinaryActionStatus). At most one ACTIVE row per (employee, type) at
// a time - see DisciplinaryActionService for the sequencing/escalation
// rules this enforces on write (ST only in order 1->2, SP independent of
// ST, an active SP blocks new ST entirely).
model EmployeeDisciplinaryAction {
  id          String   @id @default(cuid())
  employee_id String
  employee    Employee @relation(fields: [employee_id], references: [id])

  type   DisciplinaryActionType
  level  Int
  status DisciplinaryActionStatus @default(ACTIVE)

  issued_date DateTime
  valid_until DateTime

  reason String
  notes  String?

  issued_by_admin_id String?
  issued_by_admin    AdminUser? @relation(fields: [issued_by_admin_id], references: [id])

  resolved_at     DateTime?
  resolved_reason String?

  attachments DisciplinaryActionAttachment[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([employee_id, type, status])
  @@map("employee_disciplinary_actions")
}

model DisciplinaryActionAttachment {
  id                     String                     @id @default(cuid())
  disciplinary_action_id String
  disciplinary_action    EmployeeDisciplinaryAction @relation(fields: [disciplinary_action_id], references: [id])
  file_name              String
  object_key             String                     @unique
  file_size              Int
  mime_type              String
  uploaded_by            String
  uploaded_at            DateTime                   @default(now())
  deleted_at             DateTime?

  @@map("disciplinary_action_attachments")
}

model AdminUser {
  id        String    @id @default(cuid())
  admin_no  Int       @unique @default(autoincrement())
  email     String    @unique
  full_name String
  role      AdminRole @default(VIEWER)

  unit_id String
  unit    MasterUnit @relation(fields: [unit_id], references: [id])

  can_view_sensitive_data Boolean   @default(false)
  can_view_all_units      Boolean   @default(false)
  can_view_employee_pii   Boolean   @default(false)
  // The only write-capability flags - there's no separate general
  // can_write_data any more. Class CRUD (create/update/remove) reads as
  // can_write_student_data (a class exists to house students); teacher
  // assignment (assignTeacher/endTeacherAssignment/reopenTeacherAssignment/
  // removeTeacherAssignment/bulkMoveTeacherAssignments) reads as
  // can_write_employee_data - referencing a teacher there isn't "writing
  // employee data" in the HR sense, but it's the closer of the two domains.
  can_write_employee_data Boolean   @default(false)
  can_write_student_data  Boolean   @default(false)
  after_hours_write_until DateTime?

  google_id          String?   @unique
  avatar_url         String?
