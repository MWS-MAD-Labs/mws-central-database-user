generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums 

enum PersonType {
  STUDENT
  EMPLOYEE
}

enum Gender {
  MALE
  FEMALE
}

enum Religion {
  ISLAM
  PROTESTANTISM
  CATHOLICISM
  HINDUISM
  BUDDHISM
  CONFUCIANISM
  OTHER
}

enum StudentStatus {
  REGISTERED
  ACTIVE
  INACTIVE
  GRADUATED
  TRANSFERRED
  WITHDRAWN
  ARCHIVED
}

// Drives digit 4 of the auto-generated NIS (0=PRE_K, 1=PSB, 2=TRANSFER).
enum StudentEntryType {
  PRE_K
  PSB
  TRANSFER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  ON_LEAVE
  ARCHIVED
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  PART_TIME
  PROBATION
  FREELANCE
  WFH
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum AcademicYearStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  UPCOMING
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  WITHDRAWN
}

enum ParentType {
  FATHER
  MOTHER
  GUARDIAN
}

enum ConsentType {
  MEDIA_CONSENT
  PARENT_CONSENT
  DOCUMENTATION_CONSENT
  OTHER
}

enum VaccineType {
  POLIO
  DPT
  MEASLES
  HEPATITIS_B
  BCG
  MMR
  COVID_1
  COVID_2
}

enum ConsentStatus {
  PENDING
  SIGNED
  DECLINED
  EXPIRED
}

enum PCDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
}

enum HealthNoteCategory {
  HEALTH_INFO
  SPECIAL_NEEDS
}

enum HealthNoteStatus {
  ACTIVE
  RESOLVED
}

enum AdminRole {
  SUPER_ADMIN
  DATABASE_ADMIN
  VIEWER
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  UNAUTHORIZED_ACCESS
  CREATE_STUDENT
  UPDATE_STUDENT
  DEACTIVATE_STUDENT
  REACTIVATE_STUDENT
  DELETE_STUDENT
  REISSUE_STUDENT_NIS
  UPLOAD_STUDENT_PHOTO
  DELETE_STUDENT_PHOTO
  CREATE_EMPLOYEE
  UPDATE_EMPLOYEE
  DEACTIVATE_EMPLOYEE
  DELETE_EMPLOYEE
  CREATE_ACADEMIC_YEAR
  UPDATE_ACADEMIC_YEAR
  DELETE_ACADEMIC_YEAR
  CREATE_CLASS
  UPDATE_CLASS
  DELETE_CLASS
  ASSIGN_CLASS_TEACHER
  END_CLASS_TEACHER_ASSIGNMENT
  CREATE_ENROLLMENT
  PROMOTE_STUDENT
  TRANSFER_STUDENT_CLASS
  WITHDRAW_STUDENT_ENROLLMENT
  DELETE_ENROLLMENT
  RESTORE_ENROLLMENT
  REACTIVATE_ENROLLMENT
  ROLLBACK_PROMOTE_ENROLLMENT
  CREATE_PARENT_GUARDIAN
  UPDATE_PARENT_GUARDIAN
  DELETE_PARENT_GUARDIAN
  CREATE_CONSENT
  UPDATE_CONSENT
  DELETE_CONSENT
  CREATE_HEALTH_RECORD
  UPDATE_HEALTH_RECORD
  DELETE_HEALTH_RECORD
  CREATE_HEALTH_NOTE
  UPDATE_HEALTH_NOTE
  DELETE_HEALTH_NOTE
  CREATE_VACCINE_RECORD
  UPDATE_VACCINE_RECORD
  DELETE_VACCINE_RECORD
  ASSIGN_STUDENT_SUPPORT
  END_STUDENT_SUPPORT_ASSIGNMENT
  CREATE_PC_ACTIVITY
  UPDATE_PC_ACTIVITY
  DELETE_PC_ACTIVITY
  CREATE_MASTER_DATA
  UPDATE_MASTER_DATA
  DELETE_MASTER_DATA
  IMPORT_DATA
  ROLLBACK_IMPORT
  EXPORT_DATA
  UPLOAD_ATTACHMENT
  DOWNLOAD_ATTACHMENT
  DELETE_ATTACHMENT
  RESTORE_ATTACHMENT
  ACCESS_HEALTH_DATA
  API_ACCESS
  API_TOKEN_CREATE
  API_TOKEN_REVOKE
  API_TOKEN_ROTATE
  ROLE_CHANGE
  PERMISSION_CHANGE
}

enum AuditSource {
  UI
  API
  SYSTEM
  IMPORT
}

enum ImportType {
  STUDENT
  EMPLOYEE
}

enum ImportMode {
  FULL_REGISTRATION
  RELATION_ATTACH
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  PARTIAL
  ROLLED_BACK
}


model MasterUnit {
  id          String     @id @default(cuid())
  name        String     @unique 
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  employees   Employee[]

  admin_users AdminUser[]

  grades      Grade[]

  @@map("master_units")
}

model MasterJobPosition {
  id          String     @id @default(cuid())
  name        String     @unique
  is_teaching_position Boolean @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  employees   Employee[]

  @@map("master_job_positions")
}

model MasterJobLevel {
  id          String     @id @default(cuid())
  name        String     @unique
  is_teaching_role Boolean @default(false)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  employees   Employee[]

  @@map("master_job_levels")
}

model MasterBuilding {
  id          String     @id @default(cuid())
  name        String     @unique
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  employees   Employee[]

  @@map("master_buildings")
}

model MasterPCActivity {
  id          String     @id @default(cuid())
  name        String     @unique
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  pc_activities PassionConnectionActivity[]

  @@map("master_pc_activities")
}

// Models

model Person {
  id          String     @id @default(cuid())
  full_name   String
  nick_name   String
  email       String     @unique
  person_type PersonType
  gender      Gender
  religion    Religion
  birth_place String
  birth_date  DateTime
  // Legacy - a raw external URL (mostly Google Drive links from the old
  // spreadsheet). Falls back to this only when photo_object_key is unset.
  photo_url   String?
  // MinIO object key for an uploaded photo (resized + converted to WebP on
  // upload - see StudentPhotoService). The bucket is private; a presigned
  // URL is generated on read, never stored, since a stored one would go
  // stale. Reuses the existing photo_url field name in API responses -
  // callers don't need to know which source it came from.
  photo_object_key String?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?

  student  Student?
  employee Employee?

  @@map("persons")
}

model Student {
  id                 String        @id @default(cuid())
  person_id          String        @unique
  person             Person        @relation(fields: [person_id], references: [id])
  // Nullable to support legacy imports whose old NIS doesn't match the
  // strict pattern - legacy_nis preserves the original value, nis gets
  // backfilled later via StudentService.reissueNis().
  nis                String?       @unique
  legacy_nis         String?
  nisn               String?       @unique
  status             StudentStatus @default(REGISTERED)
  pre_delete_status  StudentStatus?
  current_grade_id   String
  current_grade      Grade         @relation("StudentCurrentGrade", fields: [current_grade_id], references: [id])
  current_class_id   String?
  current_class      Class?        @relation("CurrentClass", fields: [current_class_id], references: [id])
  join_academic_year_id String
  join_academic_year    AcademicYear @relation("StudentJoinAcademicYear", fields: [join_academic_year_id], references: [id])
  join_grade_id      String
  join_grade         Grade         @relation("StudentJoinGrade", fields: [join_grade_id], references: [id])
  graduation_grade   String?
  previous_school    String?
  leave_year         String?
  sn                 String?
  pickup_drop_service Boolean      @default(false)
  catering_service    Boolean      @default(false)
  psb_guide           Boolean      @default(false)
  // DB-level default only covers the migration on pre-existing rows - the
  // Zod create schema requires this explicitly for every new student.
  entry_type         StudentEntryType @default(PSB)
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  deleted_at         DateTime?

  parents            ParentGuardian[]
  enrollments        StudentClassEnrollment[]
  consents           ConsentRecord[]
  health             HealthRecord?
  health_notes       HealthNote[]
  pc                 PassionConnectionActivity[]
  vaccine_records    VaccineRecord[]
  support_assignments StudentSupportAssignment[]

  @@map("students")
}

model Employee {
  id                String          @id @default(cuid())
  person_id         String          @unique
  person            Person          @relation(fields: [person_id], references: [id])
  employee_id       String          @unique
  status            EmployeeStatus  @default(ACTIVE)
  employment_type   EmploymentType
  
  unit_id           String
  unit              MasterUnit         @relation(fields: [unit_id], references: [id])
  job_position_id   String
  job_position      MasterJobPosition  @relation(fields: [job_position_id], references: [id])
  job_level_id      String
  job_level         MasterJobLevel     @relation(fields: [job_level_id], references: [id])

  building_id       String
  building          MasterBuilding     @relation(fields: [building_id], references: [id])
  join_date         DateTime
  // Planned contract expiry (relevant when employment_type = CONTRACT) -
  // distinct from resignation_date, which is only set on actual offboarding
  // and drives the 30-day account-deletion countdown.
  contract_end_date DateTime?
  resignation_date  DateTime?
  last_working_date DateTime?
  notes             String?

  mobile_phone         String?
  residential_address  String?
  marital_status       MaritalStatus
  // These identity/sensitive fields are cleared (set to null) when the
  // employee is soft-deleted (see EmployeeService.remove) - that frees the
  // value for someone else if it was a mistaken entry, while the pre-delete
  // value is still preserved in the audit log.
  nik                  String?              @unique
  npwp                 String?              @unique
  bank_account_number  String?              @unique
  // BPJS Kesehatan (health insurance program) - 13 digits.
  bpjs_number          String?              @unique
  // BPJS Ketenagakerjaan (employment/workforce social security program) -
  // a separate program from bpjs_number above, 11 digits.
  bpjs_employment_number String?            @unique

  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  deleted_at        DateTime?

  class_assignments   ClassTeacherAssignment[]
  student_assignments StudentSupportAssignment[]
  pc_activities       PassionConnectionActivity[]

  @@map("employees")
}

model AdminUser {
  id         String    @id @default(cuid())
  admin_no   Int       @unique @default(autoincrement())
  email      String    @unique
  full_name  String
  role       AdminRole @default(VIEWER)
  
  unit_id    String
  unit       MasterUnit @relation(fields: [unit_id], references: [id])

  can_write_data      Boolean   @default(false)
  can_view_sensitive_data Boolean @default(false)
  can_view_all_units  Boolean   @default(false)
  can_view_employee_pii Boolean @default(false)
  after_hours_write_until DateTime?

  google_id  String?   @unique
  avatar_url String?
  is_active           Boolean   @default(true)
  last_login          DateTime?
  refresh_token_hash  String?   @unique
  refresh_token_exp   DateTime?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  audit_logs AuditLog[]

  @@map("admin_users")
}


model WorkingDayOverride {
  id         String   @id @default(cuid())
  date       DateTime @unique
  reason     String?
  created_at DateTime @default(now())

  @@map("working_day_overrides")
}

model ParentGuardian {
  id         String     @id @default(cuid())
  student_id String
  student    Student    @relation(fields: [student_id], references: [id])
  type       ParentType
  full_name  String
  phone      String?
  email      String?
  address    String?
  is_primary Boolean    @default(false)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  deleted_at DateTime?

  @@map("parent_guardians")
}

model ConsentRecord {
  id              String        @id @default(cuid())
  student_id      String
  student         Student       @relation(fields: [student_id], references: [id])
  consent_type    ConsentType
  status          ConsentStatus @default(PENDING)
  consent_date    DateTime?
  signed_by       String?
  notes           String?
  validity_period DateTime?
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  deleted_at      DateTime?

  attachments ConsentAttachment[]

  // Uniqueness on (student_id, consent_type) enforced by a partial index in the migration.
  @@map("consent_records")
}

model ConsentAttachment {
  id          String        @id @default(cuid())
  consent_id  String
  consent     ConsentRecord @relation(fields: [consent_id], references: [id])
  file_name   String
  object_key  String        @unique
  file_size   Int
  mime_type   String
  uploaded_by String
  uploaded_at DateTime      @default(now())
  deleted_at  DateTime?

  @@map("consent_attachments")
}

model HealthRecord {
  id               String    @id @default(cuid())
  student_id       String    @unique
  student          Student   @relation(fields: [student_id], references: [id])
  blood_type       String?
  needs_assistance Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  deleted_at       DateTime?

  // No "type" dimension here, unlike Consent/VaccineRecord - hard unique is correct, restore is the fix.
  @@map("health_records")
}

model HealthNote {
  id            String             @id @default(cuid())
  student_id    String
  student       Student            @relation(fields: [student_id], references: [id])
  category      HealthNoteCategory
  description   String
  status        HealthNoteStatus   @default(ACTIVE)
  noted_date    DateTime           @default(now())
  resolved_date DateTime?
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt
  deleted_at    DateTime?

  @@map("health_notes")
}

model VaccineRecord {
  id           String      @id @default(cuid())
  student_id   String
  student      Student     @relation(fields: [student_id], references: [id])
  vaccine_type VaccineType
  received     Boolean     @default(false)
  date         DateTime?
  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt
  deleted_at   DateTime?

  // Uniqueness on (student_id, vaccine_type) enforced by a partial index in the migration.
  @@map("vaccine_records")
}

model PassionConnectionActivity {
  id               String    @id @default(cuid())
  student_id       String
  student          Student   @relation(fields: [student_id], references: [id])
  day              PCDay
  activity_id      String
  activity         MasterPCActivity @relation(fields: [activity_id], references: [id])
  mentor_id        String?
  mentor           Employee?     @relation(fields: [mentor_id], references: [id])
  academic_year_id String
  academic_year    AcademicYear  @relation(fields: [academic_year_id], references: [id])
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt
  deleted_at       DateTime?

  // Uniqueness on (student_id, day, academic_year_id) enforced by a partial index in the migration.
  @@map("passion_connection_activities")
}

model AcademicYear {
  id         String             @id @default(cuid())
  name       String             @unique
  start_date DateTime
  end_date   DateTime?
  status     AcademicYearStatus @default(UPCOMING)
  created_at DateTime           @default(now())
  updated_at DateTime           @updatedAt

  classes         Class[]
  enrollments     StudentClassEnrollment[]
  students_joined Student[] @relation("StudentJoinAcademicYear")
  pc_activities   PassionConnectionActivity[]

  @@map("academic_years")
}

model Grade {
  id         String   @id @default(cuid())
  name       String   @unique
  level      Int      @unique
  unit_id    String?
  unit       MasterUnit? @relation(fields: [unit_id], references: [id])
  created_at DateTime @default(now())

  classes Class[]
  students_current Student[] @relation("StudentCurrentGrade")
  students_joined  Student[] @relation("StudentJoinGrade")

  @@map("grades")
}

model Class {
  id                  String      @id @default(cuid())
  name                String
  grade_id            String
  grade               Grade       @relation(fields: [grade_id], references: [id])
  academic_year_id    String
  academic_year       AcademicYear @relation(fields: [academic_year_id], references: [id])
  status              ClassStatus @default(ACTIVE)
  capacity            Int?
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  current_students Student[]              @relation("CurrentClass")
  enrollments      StudentClassEnrollment[]
  teacher_assignments ClassTeacherAssignment[]

  @@unique([name, academic_year_id])
  @@map("classes")
}

enum ClassTeacherRole {
  HOMEROOM
  SUPPORTING_HOMEROOM
  SUBJECT_TEACHER
}

model ClassTeacherAssignment {
  id          String           @id @default(cuid())
  class_id    String
  class       Class            @relation(fields: [class_id], references: [id], onDelete: Cascade)
  employee_id String
  employee    Employee         @relation(fields: [employee_id], references: [id])
  role        ClassTeacherRole @default(HOMEROOM)
  // A class can have several simultaneous active assignments per role
  // (multiple HOMEROOM/SUPPORTING_HOMEROOM/SUBJECT_TEACHER rows). What's
  // capped is per-employee: for HOMEROOM and SUPPORTING_HOMEROOM, one
  // employee can only hold one active assignment of that role per academic
  // year (app-level check, see assertTeacherNotAlreadyAssignedThisRoleElsewhere
  // in class-service.ts - not a DB constraint). SUBJECT_TEACHER has no cap
  // in either direction (e.g. one music teacher across several grades).
  // subject is only meaningful for SUBJECT_TEACHER (e.g. "Visual Arts").
  subject     String?
  start_date  DateTime         @default(now())
  end_date    DateTime?
  created_at  DateTime         @default(now())

  @@map("class_teacher_assignments")
}

enum StudentSupportRole {
  SPECIAL_ED
}

// Follows a specific student, not a class - e.g. a Special Ed teacher works
// with named students individually, potentially across several classes/
// grades, unlike ClassTeacherAssignment above which is scoped to a class.
model StudentSupportAssignment {
  id          String             @id @default(cuid())
  student_id  String
  student     Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  employee_id String
  employee    Employee           @relation(fields: [employee_id], references: [id])
  role        StudentSupportRole @default(SPECIAL_ED)
  notes       String?
  start_date  DateTime           @default(now())
  end_date    DateTime?
  created_at  DateTime           @default(now())

  @@map("student_support_assignments")
}

model StudentClassEnrollment {
  id                  String           @id @default(cuid())
  student_id          String
  student             Student          @relation(fields: [student_id], references: [id])
  academic_year_id    String
  academic_year       AcademicYear     @relation(fields: [academic_year_id], references: [id])
  class_id            String
  class               Class            @relation(fields: [class_id], references: [id])
  grade_level         String
  class_name_snapshot String
  enrollment_status   EnrollmentStatus @default(ACTIVE)
  start_date          DateTime?
  end_date            DateTime?
  // Set when this enrollment re-enters the same or a lower grade than the
  // student's previous one (see assertValidGradeProgression) - lets history
  // views distinguish a repeat year from a normal promotion.
  is_retention        Boolean          @default(false)
  retention_reason    String?
  // Set by promote() on the newly-created row, pointing at the enrollment it
  // was promoted from. Lets remove() find "the one to reactivate" directly
  // instead of guessing from matching dates when dropping a promoted
  // enrollment, and lets the API tell the frontend whether an enrollment is
  // rollback-eligible (Rollback) or a first enrollment (Drop).
  promoted_from_enrollment_id String?
  promoted_from               StudentClassEnrollment?  @relation("EnrollmentPromotion", fields: [promoted_from_enrollment_id], references: [id])
  promoted_to                 StudentClassEnrollment[] @relation("EnrollmentPromotion")
  created_at          DateTime         @default(now())
  updated_at          DateTime         @updatedAt
  deleted_at          DateTime?

  // Uniqueness on (student_id, academic_year_id) enforced by a partial index in the migration.
  @@index([promoted_from_enrollment_id])
  @@map("student_class_enrollments")
}

model ApiClient {
  id           String    @id @default(cuid())
  name         String    @unique
  description  String?
  token_prefix String    @unique
  token_hash   String
  is_active    Boolean   @default(true)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt
  last_used_at DateTime?

  scopes     ApiClientScope[]
  audit_logs AuditLog[]

  @@map("api_clients")
}

model ApiScope {
  id          String @id @default(cuid())
  name        String @unique
  description String?

  clients ApiClientScope[]

  @@map("api_scopes")
}

model ApiClientScope {
  client_id String
  scope_id  String
  client    ApiClient @relation(fields: [client_id], references: [id], onDelete: Cascade)
  scope     ApiScope  @relation(fields: [scope_id], references: [id], onDelete: Cascade)

  @@id([client_id, scope_id])
  @@map("api_client_scopes")
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  entity_type   String?
  entity_id     String?
  admin_id      String?
  admin         AdminUser?  @relation(fields: [admin_id], references: [id])
  api_client_id String?
  api_client    ApiClient?  @relation(fields: [api_client_id], references: [id])
  old_values    Json?
  new_values    Json?
  ip_address    String?
  user_agent    String?
  source        AuditSource @default(UI)
  created_at    DateTime    @default(now())

  @@index([admin_id])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

model ImportJob {
  id             String       @id @default(cuid())
  type           ImportType
  mode           ImportMode   @default(FULL_REGISTRATION)
  status         ImportStatus @default(PENDING)
  file_name      String?
  total_rows     Int?
  valid_rows     Int?
  error_rows     Int?
  result_summary Json?
  error_details  Json?
  field_mapping  Json?
  staged_rows    Json?
  created_by     String
  created_at     DateTime     @default(now())
  completed_at   DateTime?

  @@map("import_jobs")
}

model SyncLog {
  id            String   @id @default(cuid())
  source        String
  total_rows    Int?
  synced_rows   Int?
  conflict_rows Int?
  error_rows    Int?
  details       Json?
  created_by    String
  created_at    DateTime @default(now())

  @@map("sync_logs")
}
